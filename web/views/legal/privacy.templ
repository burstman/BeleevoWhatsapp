package viewslegal

// Privacy is the public Privacy Policy page (Meta requires each live app to
// publish one). Served unauthenticated at /privacy.
templ Privacy() {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Privacy Policy · Converty WhatsApp</title>
			<link rel="stylesheet" href="/static/css/styles.css"/>
		</head>
		<body class="h-full bg-slate-50 text-slate-900 antialiased">
			<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
				<a href="/" class="mb-6 inline-flex items-center gap-2 text-sm font-medium text-indigo-600 hover:text-indigo-700">← Back to home</a>
				<h1 class="text-3xl font-bold text-slate-900">Privacy Policy</h1>
				<p class="mt-1 text-sm text-slate-500">Last updated: September 22, 2026</p>

				<div class="mt-8 space-y-6 text-sm leading-relaxed text-slate-700">
					<section>
						<h2 class="text-lg font-semibold text-slate-900">1. Who we are</h2>
						<p class="mt-2">
							Converty WhatsApp ("the Platform") is an automated WhatsApp messaging service.
							It lets merchants connect a WhatsApp Business number and send automated
							order notifications to their customers. This policy explains what personal
							data we process, why, and the rights you have over it.
						</p>
					</section>

					<section>
						<h2 class="text-lg font-semibold text-slate-900">2. Information we collect</h2>
						<p class="mt-2">We process the following categories of information:</p>
						<ul class="mt-2 list-disc space-y-1 pl-5">
							<li><span class="font-medium">Account information</span> — when you register, we store your name, email address and a password hash to operate your account.</li>
							<li><span class="font-medium">Shop information</span> — the merchant/shop details you provide so we can link your store and provision WhatsApp messaging.</li>
							<li><span class="font-medium">Conversation partner data</span> — order event information (order identifiers, statuses, and phone numbers of your customers) that you configure us to process in order to send WhatsApp notifications on your behalf.</li>
							<li><span class="font-medium">Delivery metadata</span> — WhatsApp message delivery status and timestamps, used to report whether a notification was sent and delivered.</li>
						</ul>
					</section>

					<section>
						<h2 class="text-lg font-semibold text-slate-900">3. How we use information</h2>
						<p class="mt-2">
							We use the information we collect solely to provide and improve the Service
							you signed up for: authenticating you, provisioning your WhatsApp number
							connection, sending the notifications you configure, and monitoring message
							delivery. We do not sell your personal data or your customers' data.
						</p>
					</section>

					<section>
						<h2 class="text-lg font-semibold text-slate-900">4. Legal bases</h2>
						<p class="mt-2">
							We process personal data on the basis of (a) performance of the contract
							between you and the Platform, (b) our legitimate interest in operating and
							securing the Service, and (c) your consent where applicable. Where we
							process data at the direction of a merchant (e.g. customer phone numbers
							used in order notifications), we act as a processor on that merchant's behalf,
							and the merchant is responsible for the lawful basis applicable to that
							processing under their own obligations (including GDPR).
						</p>
					</section>

					<section>
						<h2 class="text-lg font-semibold text-slate-900">5. How we share information</h2>
						<p class="mt-2">
							We share information only to the extent necessary to operate the Service.
							This includes Meta Platforms, Inc. (the provider of WhatsApp Business
							infrastructure through which messages are delivered), and hosting/cloud
							infrastructure providers we rely on. Our service providers are bound by
							confidentiality and data-protection obligations. We may disclose data where
							required by law, or to protect the rights and safety of users and the public.
						</p>
					</section>

					<section>
						<h2 class="text-lg font-semibold text-slate-900">6. How long we keep data</h2>
						<p class="mt-2">
							We retain account data for as long as your account is active, and delete or
							anonymise it within a reasonable period after you close your account.
							Message audit records are retained to support delivery tracking and
							dispute resolution, then deleted. Backups and logs are retained for
							security and continuity purposes in line with industry practice.
						</p>
					</section>

					<section>
						<h2 class="text-lg font-semibold text-slate-900">7. Security</h2>
						<p class="mt-2">
							Access tokens and sensitive credentials are encrypted at rest, and access
							to production systems is restricted and monitored. No method of
							transmission or storage is completely secure, and we cannot guarantee
							absolute security.
						</p>
					</section>

					<section>
						<h2 class="text-lg font-semibold text-slate-900">8. Your rights</h2>
						<p class="mt-2">
							Depending on where you live, you may have rights of access, rectification,
							erasure, restriction, portability and objection under applicable data
							protection law (including the GDPR if you are in the EEA). To exercise a
							right, contact us using the details below. You may also complain to your
							local supervisory authority.
						</p>
					</section>

					<section>
						<h2 class="text-lg font-semibold text-slate-900">9. Contact</h2>
						<p class="mt-2">
							Questions about this policy or your data can be sent to our support team.
							Please reference "Privacy" in the subject line. (Update this section with
							your contact email address before going live.)
						</p>
					</section>

					<section>
						<h2 class="text-lg font-semibold text-slate-900">10. Changes to this policy</h2>
						<p class="mt-2">
							We may update this policy from time to time. The "Last updated" date at the
							top of this page reflects the latest revision. Material changes will be
							notified through the Service where reasonably practicable.
						</p>
					</section>
				</div>

				<footer class="mt-12 flex items-center gap-4 border-t border-slate-200 pt-4 text-xs text-slate-500">
					<span>Converty WhatsApp © 2026</span>
					<a href="/privacy" class="font-medium text-slate-600">Privacy</a>
				</footer>
			</div>
		</body>
	</html>
}