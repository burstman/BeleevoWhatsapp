package layouts

import (
	"whatsappconverty/web/views/components"
)

type NavItem struct {
	Label   string
	Href    string
	Section string
}

templ navLink(item NavItem, page components.Page) {
	<a href={ templ.SafeURL(item.Href) } class={ "flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium transition ", page.ActiveClass(item.Section) }>
		{ item.Label }
	</a>
}

// shopSwitcher is the topbar dropdown the operator uses to pick the shop the
// dashboard currently operates on.
templ shopSwitcher(page components.Page) {
	<div class="relative" x-data="{ open: false }">
		<button type="button" @click="open = !open" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm text-slate-600 transition hover:bg-slate-100" aria-haspopup="true" :aria-expanded="open.toString()">
			<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V5a2 2 0 012-2h10a2 2 0 012 2v16"/></svg>
			<span class="max-w-[10rem] truncate font-medium text-slate-900">{ page.ShopName }</span>
			<svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
		</button>
		<div x-show="open" @click.outside="open = false" x-transition
			class="absolute right-0 z-50 mt-2 w-64 overflow-hidden rounded-lg border border-slate-200 bg-white py-1 shadow-lg">
			<p class="px-3 py-1.5 text-xs font-medium uppercase tracking-wide text-slate-400">Shops</p>
			for _, s := range page.Shops {
				if s.ID == page.ActiveShopID {
					<div class="flex items-center justify-between px-3 py-2 text-sm font-medium text-slate-900">
						<span class="truncate">{ s.Name }</span>
						<svg class="h-4 w-4 shrink-0 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
					</div>
				} else {
					<a href={ templ.SafeURL("/shops/"+s.ID.String()+"/select") } class="block truncate px-3 py-2 text-sm text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">
						{ s.Name }
					</a>
				}
			}
			<a href="/shops" class="block border-t border-slate-100 px-3 py-2 text-sm font-medium text-indigo-600 transition hover:bg-indigo-50">
				Manage shops
			</a>
		</div>
	</div>
}

// Shell is the authenticated dashboard layout: sidebar, topbar and content.
templ Shell(page components.Page) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ page.Title } · Converty WhatsApp</title>
			<link rel="stylesheet" href="/static/css/styles.css"/>
			<script src="/static/js/htmx.min.js" defer></script>
			<script src="/static/js/alpine.min.js" defer></script>
		</head>
		<body class="h-full bg-slate-100 text-slate-900 antialiased">
			<div class="flex min-h-full" x-data="{ sidebarOpen: false }">
				<aside class="fixed inset-y-0 left-0 z-40 w-64 transform bg-slate-900 transition lg:static lg:translate-x-0" :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'">
					<div class="flex h-16 items-center gap-2 border-b border-slate-800 px-6">
						<span class="text-sm font-semibold text-white">Converty</span>
						<span class="text-sm text-slate-400">WhatsApp</span>
					</div>
					<nav class="space-y-1 p-4">
						@navLink(NavItem{"Overview", "/dashboard", "overview"}, page)
						@navLink(NavItem{"Shops", "/shops", "shops"}, page)
						@navLink(NavItem{"Shop Integration", "/integrations", "integrations"}, page)
						@navLink(NavItem{"Automations", "/automations", "automations"}, page)
						@navLink(NavItem{"Templates", "/templates", "templates"}, page)
						@navLink(NavItem{"Messages", "/messages", "messages"}, page)
						@navLink(NavItem{"Settings", "/settings", "settings"}, page)
					</nav>
				</aside>

				<div class="fixed inset-0 z-30 bg-black/50 lg:hidden" :class="sidebarOpen ? '' : 'hidden'"></div>

				<div class="flex min-w-0 flex-1 flex-col">
					<header class="flex h-16 items-center justify-between border-b border-slate-200 bg-white px-4 sm:px-6">
						<div class="flex items-center gap-3">
							<button type="button" class="rounded-md p-2 text-slate-600 hover:bg-slate-100 lg:hidden" @click="sidebarOpen = true" aria-label="Open menu">
								<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
							</button>
							<h1 class="text-lg font-semibold text-slate-900">{ page.Title }</h1>
						</div>
						<div class="flex items-center gap-4">
							@shopSwitcher(page)
							@components.LogoutForm()
						</div>
					</header>
					<main class="flex-1 p-4 sm:p-6">
						{ children... }
					</main>
				</div>
			</div>
			@components.ToastTarget()
		</body>
	</html>
}

// AuthLayout is the centered card layout used for login and registration.
templ AuthLayout(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Converty WhatsApp</title>
			<link rel="stylesheet" href="/static/css/styles.css"/>
			<script src="/static/js/htmx.min.js" defer></script>
		</head>
		<body class="flex min-h-full items-center justify-center bg-slate-100 px-4 py-12 text-slate-900">
			<div class="w-full max-w-md">
				<div class="mb-8 text-center">
					<h1 class="text-2xl font-bold text-slate-900">Converty WhatsApp</h1>
					<p class="mt-1 text-sm text-slate-500">Automated order notifications for your shop</p>
				</div>
				{ children... }
			</div>
		</body>
	</html>
}