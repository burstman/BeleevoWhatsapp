package settings

import (
	"whatsappconverty/internal/shops"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

// Onboarding enables the platform's shared WhatsApp service for a merchant.
// The merchant does NOT connect its own number: all messages go through the
// platform's centrally owned WABA and phone number. Enabling requires an
// explicit, audited acceptance of the service terms, which include the
// customer opt-in obligations.
templ Onboarding(page components.Page, shop shops.Shop) {
	@layouts.Shell(page) {
		<div class="mx-auto max-w-2xl">
			<h1 class="text-2xl font-bold text-slate-900">{ page.T("onb.title") }</h1>
			<p class="mt-1 text-sm text-slate-500">
				{ page.T("onb.subtitleA") }<span class="font-medium text-slate-700">{ page.T("onb.subtitleOur") }</span>{ page.T("onb.subtitleB") }
			</p>

			<div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
				if shop.WhatsappEnabled {
					<div class="flex items-center gap-3 rounded-lg bg-emerald-50 px-4 py-3">
						<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
						<span class="text-sm font-medium text-emerald-800">{ page.T("onb.enabled") }</span>
					</div>
				}

				<form method="post" action="/whatsapp/onboard" class="mt-6 space-y-5">
					<div>
						<label for="shop-phone" class="block text-sm font-medium text-slate-700">{ page.T("onb.phoneLabel") }</label>
						<input id="shop-phone" name="shop_phone" type="text"
							value={ shop.Phone }
							placeholder="+216 ..."
							class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500"/>
					</div>

					<div class="rounded-lg border border-slate-200 p-4">
						<label class="flex cursor-pointer items-start gap-3">
							<input type="checkbox" name="accept_terms" value="1" required
								class="mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"/>
							<div class="text-sm text-slate-600">
								{ page.T("onb.consentA") }<span class="font-medium text-slate-800">{ page.T("onb.consentB") }</span>{ page.T("onb.consentC") }<a href="/privacy" class="text-indigo-600 underline">{ page.T("onb.consentTerms") }</a>.
							</div>
						</label>
					</div>

					<button type="submit"
						class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
						{ page.T("onb.submit") }
					</button>
				</form>
			</div>
		</div>
	}
}