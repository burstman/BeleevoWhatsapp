package settings

import (
	"whatsappconverty/internal/i18n"
	"whatsappconverty/internal/whatsapp"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

// AutoreplyFlash carries the one-line feedback shown above the form.
type AutoreplyFlash struct {
	Error string
	Info  string
}

// Autoreply is the first-contact auto-reply settings page. cfg is the saved
// greeting: its Kind drives which editor is shown and its MediaMime tells the
// page whether a stored file exists to preview.
templ Autoreply(page components.Page, dict *i18n.Dict, cfg whatsapp.FirstContactAutoreply, flash AutoreplyFlash) {
	@layouts.Shell(page) {
		<div class="mx-auto max-w-3xl space-y-6">
			<div>
				<h1 class="text-2xl font-bold text-slate-900">{ page.T("far.title") }</h1>
				<p class="mt-1 text-sm text-slate-500">{ page.T("far.subtitle") }</p>
			</div>

			if flash.Error != "" {
				<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{ flash.Error }</div>
			}
			if flash.Info != "" {
				<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">{ flash.Info }</div>
			}

			<form method="post" action="/settings/autoreply" enctype="multipart/form-data"
				class="space-y-6" x-data="{ kind: $el.dataset.kind }" data-kind={ cfg.Kind }>
				<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
					<label class="flex items-start gap-3">
						<input type="checkbox" name="enabled" value="1" checked={ cfg.Enabled }
							class="mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
						<span>
							<span class="block text-sm font-medium text-slate-900">{ page.T("far.enabled") }</span>
							<span class="mt-0.5 block text-xs text-slate-500">{ page.T("far.runOnce") }</span>
						</span>
					</label>
				</div>

				<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
					<span class="block text-sm font-medium text-slate-700">{ page.T("far.kind") }</span>
					<div class="mt-3 flex flex-wrap gap-2">
						<label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-2 text-sm"
							:class="kind === 'text' ? 'border-indigo-500 bg-indigo-50 text-indigo-700' : 'border-slate-300 text-slate-700'">
							<input type="radio" name="kind" value="text" x-model="kind" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" />
							{ page.T("far.kindText") }
						</label>
						<label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-2 text-sm"
							:class="kind === 'image' ? 'border-indigo-500 bg-indigo-50 text-indigo-700' : 'border-slate-300 text-slate-700'">
							<input type="radio" name="kind" value="image" x-model="kind" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" />
							{ page.T("far.kindImage") }
						</label>
						<label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-2 text-sm"
							:class="kind === 'audio' ? 'border-indigo-500 bg-indigo-50 text-indigo-700' : 'border-slate-300 text-slate-700'">
							<input type="radio" name="kind" value="audio" x-model="kind" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" />
							{ page.T("far.kindAudio") }
						</label>
					</div>

					<div x-show="kind === 'text'" class="mt-5">
						<label for="far-text" class="block text-sm font-medium text-slate-700">{ page.T("far.textLabel") }</label>
						<textarea id="far-text" name="text_body" rows="4" maxlength="2000"
							placeholder={ page.T("far.textPlaceholder") }
							class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">{ cfg.TextBody }</textarea>
					</div>

					<div x-show="kind === 'image'" class="mt-5 space-y-4">
						<div>
							<label for="far-caption" class="block text-sm font-medium text-slate-700">{ page.T("far.captionLabel") }</label>
							<input id="far-caption" name="caption" type="text" maxlength="1024" value={ cfg.Caption }
								class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
						</div>
						<div>
							<label for="far-image" class="block text-sm font-medium text-slate-700">{ page.T("far.imageLabel") }</label>
							<input id="far-image" name="image" type="file" accept="image/jpeg,image/png,image/webp"
								class="mt-1 block w-full text-sm text-slate-700 file:me-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-indigo-700 hover:file:bg-indigo-100" />
							if cfg.Kind == "image" && cfg.MediaMime != "" {
								<p class="mt-1 text-xs text-slate-500">{ page.T("far.keepCurrent") }</p>
							}
						</div>
						if cfg.Kind == "image" && cfg.MediaMime != "" {
							<div>
								<span class="block text-xs font-medium text-slate-500">{ page.T("far.preview") }</span>
								<img src="/settings/autoreply/media" alt={ page.T("far.preview") } class="mt-2 max-h-48 rounded-lg border border-slate-200 object-cover" />
							</div>
						}
					</div>

					<div x-show="kind === 'audio'" class="mt-5 space-y-4">
						<div>
							<label for="far-audio" class="block text-sm font-medium text-slate-700">{ page.T("far.audioLabel") }</label>
							<input id="far-audio" name="audio" type="file" accept="audio/mpeg,audio/mp4,audio/aac,audio/amr,audio/ogg"
								class="mt-1 block w-full text-sm text-slate-700 file:me-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-indigo-700 hover:file:bg-indigo-100" />
							if cfg.Kind == "audio" && cfg.MediaMime != "" {
								<p class="mt-1 text-xs text-slate-500">{ page.T("far.keepCurrent") }</p>
							}
						</div>
						if cfg.Kind == "audio" && cfg.MediaMime != "" {
							<div>
								<span class="block text-xs font-medium text-slate-500">{ page.T("far.preview") }</span>
								<audio controls preload="metadata" src="/settings/autoreply/media" class="mt-2 w-full"></audio>
							</div>
						}
					</div>
				</div>

				<div class="flex justify-end">
					<button type="submit"
						class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
						{ page.T("far.save") }
					</button>
				</div>
			</form>
		</div>
	}
}
