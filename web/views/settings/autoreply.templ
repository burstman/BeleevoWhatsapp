package settings

import (
	"whatsappconverty/internal/i18n"
	"whatsappconverty/internal/whatsapp"
)

// AutoreplyFlash carries the one-line feedback shown above the form.
type AutoreplyFlash struct {
	Error string
	Info  string
}

// AutoreplyModal is the first-contact auto-reply editor shown inside the inbox
// modal. It is the only thing /settings/autoreply renders: the route returns
// this fragment for the inbox button's htmx request. The close/cancel controls
// rely on the Alpine scope (autoreplyOpen) owned by the inbox page.
templ AutoreplyModal(dict *i18n.Dict, cfg whatsapp.FirstContactAutoreply, flash AutoreplyFlash) {
	<div>
		<div class="flex items-start justify-between gap-4">
			<div>
				<h4 class="text-base font-semibold text-slate-900">{ dict.T("far.title") }</h4>
				<p class="mt-1 text-sm text-slate-500">{ dict.T("far.subtitle") }</p>
			</div>
			<button type="button" @click="autoreplyOpen = false"
				class="rounded-lg p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600">
				<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>

		if flash.Error != "" {
			<div class="mt-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700">{ flash.Error }</div>
		}
		if flash.Info != "" {
			<div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-700">{ flash.Info }</div>
		}

		<form hx-post="/settings/autoreply" hx-encoding="multipart/form-data"
			hx-target="#autoreply-modal-body" hx-swap="innerHTML"
			class="mt-4 space-y-5" x-data="{ kind: $el.dataset.kind }" data-kind={ cfg.Kind }>
			<label class="flex items-start gap-3">
				<input type="checkbox" name="enabled" value="1" checked={ cfg.Enabled }
					class="mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
				<span>
					<span class="block text-sm font-medium text-slate-900">{ dict.T("far.enabled") }</span>
					<span class="mt-0.5 block text-xs text-slate-500">{ dict.T("far.runOnce") }</span>
				</span>
			</label>

			<div>
				<span class="block text-sm font-medium text-slate-700">{ dict.T("far.kind") }</span>
				<div class="mt-3 flex flex-wrap gap-2">
					<label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-2 text-sm"
						:class="kind === 'text' ? 'border-indigo-500 bg-indigo-50 text-indigo-700' : 'border-slate-300 text-slate-700'">
						<input type="radio" name="kind" value="text" x-model="kind" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" />
						{ dict.T("far.kindText") }
					</label>
					<label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-2 text-sm"
						:class="kind === 'image' ? 'border-indigo-500 bg-indigo-50 text-indigo-700' : 'border-slate-300 text-slate-700'">
						<input type="radio" name="kind" value="image" x-model="kind" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" />
						{ dict.T("far.kindImage") }
					</label>
					<label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-2 text-sm"
						:class="kind === 'audio' ? 'border-indigo-500 bg-indigo-50 text-indigo-700' : 'border-slate-300 text-slate-700'">
						<input type="radio" name="kind" value="audio" x-model="kind" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" />
						{ dict.T("far.kindAudio") }
					</label>
				</div>
			</div>

			<div x-show="kind === 'text'" x-cloak>
				<label for="far-text" class="block text-xs font-medium text-slate-600">{ dict.T("far.textLabel") }</label>
				<textarea id="far-text" name="text_body" rows="4" maxlength="2000"
					placeholder={ dict.T("far.textPlaceholder") }
					class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500">{ cfg.TextBody }</textarea>
			</div>

			<div x-show="kind === 'image'" x-cloak class="space-y-4">
				<div>
					<label for="far-caption" class="block text-xs font-medium text-slate-600">{ dict.T("far.captionLabel") }</label>
					<input id="far-caption" name="caption" type="text" maxlength="1024" value={ cfg.Caption }
						class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" />
				</div>
				<div>
					<label for="far-image" class="block text-xs font-medium text-slate-600">{ dict.T("far.imageLabel") }</label>
					<input id="far-image" name="image" type="file" accept="image/jpeg,image/png,image/webp"
						class="mt-1 block w-full text-sm text-slate-700 file:me-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-indigo-700 hover:file:bg-indigo-100" />
					if cfg.Kind == "image" && cfg.MediaMime != "" {
						<p class="mt-1 text-xs text-slate-500">{ dict.T("far.keepCurrent") }</p>
					}
				</div>
				if cfg.Kind == "image" && cfg.MediaMime != "" {
					<img src="/settings/autoreply/media" alt={ dict.T("far.preview") } class="max-h-40 rounded-lg border border-slate-200 object-cover" />
				}
			</div>

			<div x-show="kind === 'audio'" x-cloak class="space-y-4">
				<div>
					<label for="far-audio" class="block text-xs font-medium text-slate-600">{ dict.T("far.audioLabel") }</label>
					<input id="far-audio" name="audio" type="file" accept="audio/mpeg,audio/mp4,audio/aac,audio/amr,audio/ogg"
						class="mt-1 block w-full text-sm text-slate-700 file:me-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-indigo-700 hover:file:bg-indigo-100" />
					if cfg.Kind == "audio" && cfg.MediaMime != "" {
						<p class="mt-1 text-xs text-slate-500">{ dict.T("far.keepCurrent") }</p>
					}
				</div>
				if cfg.Kind == "audio" && cfg.MediaMime != "" {
					<audio controls preload="metadata" src="/settings/autoreply/media" class="w-full"></audio>
				}
			</div>

			<div class="flex items-center justify-end gap-2 pt-1">
				<button type="button" @click="autoreplyOpen = false"
					class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-50">{ dict.T("common.cancel") }</button>
				<button type="submit"
					class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
					{ dict.T("far.save") }
				</button>
			</div>
		</form>
	</div>
}
