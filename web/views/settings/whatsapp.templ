package settings

import (
	"whatsappconverty/internal/whatsapp"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

templ Settings(page components.Page, integ *whatsapp.Integration, templates []whatsapp.Template, receipts []whatsapp.WebhookReceipt) {
	@layouts.Shell(page) {
		<div class="mx-auto max-w-3xl">
			<h1 class="text-2xl font-bold text-slate-900">{ page.T("was.title") }</h1>
			<p class="mt-1 text-sm text-slate-500">{ page.T("was.subtitle") }</p>

			if integ == nil {
					<div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
						<h2 class="text-lg font-semibold text-slate-900">{ page.T("was.connect") }</h2>
						<p class="mt-2 text-sm text-slate-600">{ page.T("was.connectBody") }</p>
						<ol class="mt-3 list-decimal space-y-1 pl-5 text-sm text-slate-600">
							<li>{ page.T("was.step1") }</li>
							<li>{ page.T("was.step2") }</li>
							<li>{ page.T("was.step3") }</li>
						</ol>

						<form method="post" action="/whatsapp/connect" class="mt-6 space-y-4">
							<div>
								<label for="token" class="block text-sm font-medium text-slate-700">{ page.T("was.token") }</label>
								<input id="token" name="token" type="password" required
									class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
									placeholder="EAAP... long-lived"/>
							</div>
							<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
								<div>
									<label for="phone-number-id" class="block text-sm font-medium text-slate-700">{ page.T("was.phoneNumberId") }</label>
									<input id="phone-number-id" name="phone_number_id" type="text" required
										class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
										placeholder="e.g. 1302152316314738"/>
								</div>
								<div>
									<label for="messaging-account-id" class="block text-sm font-medium text-slate-700">{ page.T("was.wabaId") }</label>
									<input id="messaging-account-id" name="messaging_account_id" type="text" required
										class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
										placeholder={ page.T("was.wabaPlaceholder") }/>
								</div>
							</div>
							<button type="submit"
								class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
								{ page.T("was.connect") }
							</button>
						</form>
					</div>
				} else {
				<div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
					<div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
						<div class="flex items-center gap-3">
							<span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-700">
								<span class="h-2 w-2 rounded-full bg-emerald-500"></span> { page.T("was.connected") }
							</span>
						</div>
						<form method="post" action="/whatsapp/disconnect"
							data-confirm={ page.T("was.disconnectConfirm") }>
							<button type="submit"
								class="rounded-lg border border-rose-200 px-3 py-1.5 text-sm font-medium text-rose-600 transition hover:bg-rose-50">
								{ page.T("was.disconnect") }
							</button>
						</form>
					</div>
					<div class="px-6 py-4">
						<dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
							<div>
								<dt class="text-xs font-medium uppercase tracking-wide text-slate-400">{ page.T("was.number") }</dt>
								<dd class="mt-1 text-sm font-medium text-slate-900">{ integ.PhoneNumber }</dd>
							</div>
							<div>
								<dt class="text-xs font-medium uppercase tracking-wide text-slate-400">{ page.T("was.status") }</dt>
								<dd class="mt-1 text-sm font-medium text-slate-900">{ integ.Status }</dd>
							</div>
						</dl>
						<div class="mt-5">
							<h3 class="text-xs font-medium uppercase tracking-wide text-slate-400">{ page.Tf("was.available", len(templates)) }</h3>
							<ul class="mt-2 divide-y divide-slate-100 border-t border-slate-100">
								for _, t := range templates {
									<li class="flex items-center justify-between py-2 text-sm">
										<span class="font-medium text-slate-800">{ t.Name }</span>
										<span class="inline-flex items-center gap-2">
											<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{ t.Language }</span>
											<span class={ "rounded-full px-2 py-0.5 text-xs ", statusBadge(t.Status) }>{ t.Status }</span>
										</span>
									</li>
								}
							</ul>
						</div>
					</div>
				</div>
			}

			<div class="mt-8">
				<h2 class="text-base font-semibold text-slate-900">{ page.T("was.recent") }</h2>
				<p class="mt-1 text-sm text-slate-500">{ page.T("was.recentBody") }</p>
				<div class="mt-3 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
					if len(receipts) == 0 {
						<p class="px-4 py-6 text-center text-sm text-slate-500">{ page.T("was.none") }</p>
					} else {
						<ul class="divide-y divide-slate-100">
							for _, r := range receipts {
								<li class="flex items-center justify-between gap-4 px-4 py-3 text-sm"><span class={ "shrink-0 rounded-full px-2 py-0.5 text-xs font-medium ", receiptBadge(r.Kind) }>{ r.Kind }</span><span class="shrink-0 text-xs text-slate-400">{ r.ReceivedAt.Format("2006-01-02 15:04:05") }</span><span class="truncate text-slate-600">{ receiptText(r) }</span></li>
							}
						</ul>
					}
				</div>
			</div>
		</div>
	}
}

func receiptText(r whatsapp.WebhookReceipt) string {
	switch r.Kind {
	case "media_download_failed", "media_missing_id":
		return r.Detail
	}
	if r.FromPhone != "" {
		return r.FromPhone
	}
	return r.Detail
}

func receiptBadge(kind string) string {
	switch kind {
	case "inbound":
		return "bg-emerald-100 text-emerald-700"
	case "status":
		return "bg-indigo-100 text-indigo-700"
	case "dropped":
		return "bg-amber-100 text-amber-700"
	case "config_missing", "auth_failed":
		return "bg-rose-100 text-rose-700"
	default:
		return "bg-slate-100 text-slate-600"
	}
}

func statusBadge(status string) string {
	if status == "APPROVED" {
		return "bg-emerald-100 text-emerald-700"
	}
	if status == "PENDING" {
		return "bg-amber-100 text-amber-700"
	}
	return "bg-rose-100 text-rose-700"
}
