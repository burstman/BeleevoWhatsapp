package viewserrors

import (
	"strconv"

	"whatsappconverty/internal/i18n"
	"whatsappconverty/web/views/layouts"
)

templ ErrorPage(status int, title string, message string, dict *i18n.Dict) {
	@layouts.AuthLayout(title, dict) {
		<div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
			<p class="text-5xl font-bold text-slate-300">{ strconv.Itoa(status) }</p>
			<h2 class="mt-4 text-lg font-semibold text-slate-900">{ title }</h2>
			<p class="mt-2 text-sm text-slate-500">{ message }</p>
			<a href="/" class="mt-6 inline-block rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500">
				{ dict.T("error.goHome") }
			</a>
		</div>
	}
}

templ NotFoundPage(dict *i18n.Dict) {
	@ErrorPage(404, dict.T("error.notFoundTitle"), dict.T("error.notFoundBody"), dict)
}

templ ErrorToast(message string) {
	<div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 shadow-sm">
		{ message }
	</div>
}