package viewsdashboard

import (
	"strconv"

	"whatsappconverty/internal/dashboard"
	"whatsappconverty/internal/i18n"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

// automationsLabel pluralises the active-automation count for the setup card.
func automationsLabel(dict *i18n.Dict, n int) string {
	if n == 1 {
		return dict.T("ov.automations1")
	}
	return dict.Tf("ov.automationsN", n)
}

templ Overview(page components.Page, stats dashboard.Stats) {
	@layouts.Shell(page) {
		<div class="overview-page -m-4 sm:-m-6">
			<div class="overview-main">
				<section class="welcome">
					<div>
						<p class="eyebrow">{ page.T("ov.eyebrow") }</p>
						<h1>{ page.T("ov.welcome") }<span class="welcome-dot">.</span></h1>
						<p class="welcome-description">{ page.T("ov.welcomeDesc") }</p>
					</div>
					if stats.WhatsappConnected {
						<span class="connection-status"><span class="status-dot" ></span>{ page.T("ov.waConnected") }</span>
					} else {
						<a href="/whatsapp/onboard" class="connection-status"><span class="status-dot" ></span>{ page.T("ov.waNotEnabled") }</a>
					}
				</section>

				<section class="metrics-section">
					<div class="section-heading">
						<h2>{ page.T("ov.messaging") }</h2>
						<span class="period-label"><span class="period-dot" ></span>{ page.T("ov.allTime") }</span>
					</div>

					<div class="metrics-grid">
						<article class="metric-card">
							<div class="metric-top">
								<span class="metric-icon tone-blue">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4 20-7Z"/><path d="M22 2 11 13"/></svg>
								</span>
								<span class="metric-category">{ page.T("ov.catMessages") }</span>
							</div>
							<h3>{ page.T("ov.sent") }</h3>
							<p class="metric-value">{ strconv.Itoa(stats.MessagesSent) }</p>
							<div class="metric-footer">
								<span class="tiny-dot tone-blue" ></span>{ page.T("ov.lifetime") }
							</div>
						</article>

						<article class="metric-card">
							<div class="metric-top">
								<span class="metric-icon tone-green">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 12 4 4L19 5M10 16l3 3L23 9"/></svg>
								</span>
								<span class="metric-category">{ page.T("ov.catMessages") }</span>
							</div>
							<h3>{ page.T("ov.delivered") }</h3>
							<p class="metric-value">{ strconv.Itoa(stats.MessagesDelivered) }</p>
							<div class="metric-footer">
								<span class="tiny-dot tone-green" ></span>{ page.T("ov.lifetime") }
							</div>
						</article>

						<article class="metric-card">
							<div class="metric-top">
								<span class="metric-icon tone-red">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
								</span>
								<span class="metric-category">{ page.T("ov.catMessages") }</span>
							</div>
							<h3>{ page.T("ov.failed") }</h3>
							<p class="metric-value">{ strconv.Itoa(stats.MessagesFailed) }</p>
							<div class="metric-footer">
								<span class="tiny-dot tone-red" ></span>{ page.T("ov.lifetime") }
							</div>
						</article>

						<article class="metric-card">
							<div class="metric-top">
								<span class="metric-icon tone-gray">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="7" r="4"/><path d="M3 21v-2a7 7 0 0 1 12-5M17 16l5 5M22 16l-5 5"/></svg>
								</span>
								<span class="metric-category">{ page.T("ov.catCustomers") }</span>
							</div>
							<h3>{ page.T("ov.notOnWhatsapp") }</h3>
							<p class="metric-value">{ strconv.Itoa(stats.MessagesNotOnWhatsapp) }</p>
							<div class="metric-footer">{ page.T("ov.noWaAccount") }</div>
						</article>

						<article class="metric-card">
							<div class="metric-top">
								<span class="metric-icon tone-amber">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m13 2-9 12h7l-1 8 10-12h-7l1-8Z"/></svg>
								</span>
								<span class="metric-category">{ page.T("ov.catWorkflows") }</span>
							</div>
							<h3>{ page.T("ov.activeAutomations") }</h3>
							<p class="metric-value">{ strconv.Itoa(stats.ActiveAutomations) }</p>
							<div class="metric-footer">
								{ page.T("ov.statusToTemplate") }
							</div>
						</article>
					</div>
				</section>

				<section class="getting-started">
					<div class="section-heading">
						<h2>{ page.T("ov.gettingStarted") }</h2>
						<span class="section-caption">{ page.T("ov.setupCaption") }</span>
					</div>

					<div class="setup-grid">
						<a href="/whatsapp/onboard" class="setup-card block">
							<div class="setup-art art-whatsapp">
								<span class="art-orbit orbit-one" ></span>
								<span class="art-orbit orbit-two" ></span>
								<span class="art-main">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/><path d="M8 11h8M8 15h5"/></svg>
								</span>
								<span class="art-check">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 12 4 4L19 5M10 16l3 3L23 9"/></svg>
								</span>
								<span class="art-spark spark-one" ></span>
								<span class="art-spark spark-two" ></span>
							</div>
							<div class="setup-content">
								<span class="step-label">{ page.T("ov.step1") }</span>
								<h3>{ page.T("ov.enableWa") }</h3>
								<p>
									{ page.T("ov.enableWaBody") }
								</p>
								<div class="setup-footer">
									if stats.WhatsappConnected {
										<span class="setup-state"><span class="status-dot" ></span>{ page.T("ov.connected") }</span>
									} else {
										<span class="setup-state neutral-state">
											<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2Z"/><path d="M12 8v5M12 16h.01"/></svg>
											{ page.T("ov.notConnected") }
										</span>
									}
									<span class="step-number">01</span>
								</div>
							</div>
						</a>

						<a href="/automations" class="setup-card block">
							<div class="setup-art art-automation">
								<span class="workflow-node">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m13 2-9 12h7l-1 8 10-12h-7l1-8Z"/></svg>
								</span>
								<span class="workflow-line" ></span>
								<span class="workflow-node node-end">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/><path d="M8 11h8M8 15h5"/></svg>
								</span>
								<span class="art-spark spark-one" ></span>
								<span class="art-spark spark-two" ></span>
							</div>
							<div class="setup-content">
								<span class="step-label">{ page.T("ov.step2") }</span>
								<h3>{ page.T("ov.createAutomations") }</h3>
								<p>{ page.T("ov.createAutomationsBody") }</p>
								<div class="setup-footer">
									<span class="setup-state neutral-state">
										<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m13 2-9 12h7l-1 8 10-12h-7l1-8Z"/></svg>
										{ automationsLabel(page.I18N, stats.ActiveAutomations) }
									</span>
									<span class="step-number">02</span>
								</div>
							</div>
						</a>

						<a href="/templates" class="setup-card block">
							<div class="setup-art art-template">
								<span class="template-paper paper-back" ></span>
								<span class="template-paper paper-front">
									<span class="paper-title" ></span>
									<span class="paper-line" ></span>
									<span class="paper-line" ></span>
									<span class="paper-line short-line" ></span>
									<span class="paper-tag" ></span>
								</span>
								<span class="art-spark spark-one" ></span>
								<span class="art-spark spark-two" ></span>
							</div>
							<div class="setup-content">
								<span class="step-label">{ page.T("ov.step3") }</span>
								<h3>{ page.T("ov.manageTemplates") }</h3>
								<p>{ page.T("ov.manageTemplatesBody") }</p>
								<div class="setup-footer">
									<span class="setup-state neutral-state">
										<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M8 8h8M8 12h8M8 16h4"/></svg>
										{ page.T("ov.messageTemplates") }
									</span>
									<span class="step-number">03</span>
								</div>
							</div>
						</a>
					</div>
				</section>

				<footer class="overview-footer">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/><path d="M8 11h8M8 15h5"/></svg>
					<span>{ page.T("ov.footer") }</span>
					<span class="footer-line" ></span>
				</footer>
			</div>
		</div>
	}
}

templ Placeholder(page components.Page, section string) {
	@layouts.Shell(page) {
		@components.EmptyState(page.T("common.comingSoon"), page.Tf("common.comingSoonBody", page.T("title."+section)))
	}
}