package viewsdashboard

import (
	"strconv"

	"github.com/google/uuid"

	"whatsappconverty/internal/automations"
	"whatsappconverty/internal/shops"
	"whatsappconverty/internal/whatsapp"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

templ AutomationFormPage(page components.Page, automation *automations.Automation, templates []whatsapp.MerchantTemplate, templateShops map[uuid.UUID]string, deliveryStatuses []string, isEdit bool, flash AutomationFlash) {
	@layouts.Shell(page) {
		<div class="mx-auto max-w-6xl">
			<div class="flex items-center justify-between">
				<div>
					<h2 class="text-2xl font-bold text-slate-900">
						if isEdit {
							Edit automation
						} else {
							New automation
						}
					</h2>
					<p class="mt-1 text-sm text-slate-500">
						The template is one of your approved templates — its content is edited in the Templates menu.
					</p>
				</div>
				<a href="/automations" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-50">Back</a>
			</div>

			if flash.Error != "" {
				<div class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{ flash.Error }</div>
			}

			<form method="post" action={ templ.SafeURL(formAction(automation)) } class="mt-6 grid gap-6 lg:grid-cols-3">
				<div class="space-y-6 lg:col-span-2">
					<div class="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
						<div class="grid gap-4 sm:grid-cols-2">
							<div>
								<label for="name" class="block text-sm font-medium text-slate-700">Automation name</label>
								<input id="name" name="name" type="text" required value={ automationName(automation) }
									placeholder="e.g. Delivery notification"
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
							</div>
							<div>
								<label for="description" class="block text-sm font-medium text-slate-700">Description (optional)</label>
								<input id="description" name="description" type="text" value={ automationDescription(automation) }
									placeholder="What this automation does"
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
							</div>
						</div>

						<div>
							<label class="block text-sm font-medium text-slate-700">Send type</label>
							<div class="mt-2 flex flex-col gap-2">
								<label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700">
									<input type="radio" name="send_mode" value="instant" checked={ selectedMode(automation) == "instant" }
										class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" />
									Instant — send as soon as the event arrives
								</label>
								<label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700">
									<input type="radio" name="send_mode" value="fixed" checked={ selectedMode(automation) == "fixed" }
										class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" />
									Scheduled — send at a fixed time on the chosen days
								</label>
								<label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700">
									<input type="radio" name="send_mode" value="delayed" checked={ selectedMode(automation) == "delayed" }
										class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" />
									Delayed — send a few minutes after the event
								</label>
							</div>
						</div>
					</div>

					<div class="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
						<div class="grid gap-4 sm:grid-cols-3">
							<div>
								<label class="block text-sm font-medium text-slate-700">Shop</label>
								<select id="shopSelect" name="shop_id"
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
									for _, s := range page.Shops {
										<option value={ s.ID.String() } selected={ shopSelected(automation, s, page) }>{ s.Name }</option>
									}
								</select>
							</div>
							<div>
								<label for="eventSource" class="block text-sm font-medium text-slate-700">Event source</label>
								<select id="eventSource" name="event_source"
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
									<option value="converty" selected={ automationEventSource(automation) == "converty" }>Order event (Converty)</option>
									<option value="delivery" selected={ automationEventSource(automation) == "delivery" }>Delivery event (provider)</option>
								</select>
							</div>
							<div id="convertyTrigger">
								<label for="eventStatus" class="block text-sm font-medium text-slate-700">Trigger on</label>
								<select id="eventStatus" name="event_status" required
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
									<option value="" disabled selected={ automationStatus(automation) == "" }>Choose a status…</option>
									for _, s := range automations.ConvertyStatuses() {
										<option value={ s } selected={ automationStatus(automation) == s }>{ s }</option>
									}
								</select>
							</div>
							<div id="deliveryTrigger" class="hidden">
								<label for="eventStatusDelivery" class="block text-sm font-medium text-slate-700">Trigger on</label>
								<select id="eventStatusDelivery" name="event_status_delivery" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
									<option value="" disabled selected={ automationStatus(automation) == "" }>Choose a status…</option>
									for _, s := range deliveryStatuses {
										<option value={ s } selected={ automationStatus(automation) == s }>{ s }</option>
									}
								</select>
							</div>
						</div>
					</div>

					<div class="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
						<label for="templateSelect" class="block text-sm font-medium text-slate-700">Message (approved template)</label>
						if len(templates) == 0 {
							<div class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
								This shop has no approved template. Create and get one approved in the Templates menu.
							</div>
						} else {
							<select id="templateSelect" name="template_id" required
								class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
								<option value="" disabled selected={ automation == nil && automationTemplateID(automation) == uuid.Nil }>Choose a template…</option>
								for _, t := range templates {
									<option value={ t.ID.String() } selected={ automationTemplateID(automation) == t.ID }>{ templateOptionLabel(t, templateShops) }</option>
								}
							</select>
						}
					</div>

					<div class="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
						<h3 class="text-sm font-semibold text-slate-700">Schedule settings</h3>

						<div id="fixedSchedule" class="hidden">
							<div class="grid gap-4 sm:grid-cols-2">
								<div>
									<label class="block text-sm font-medium text-slate-700">Send days</label>
									<div class="mt-2 grid grid-cols-4 gap-2">
										for d := 1; d <= 7; d++ {
											<label class="flex cursor-pointer items-center gap-1.5 text-sm text-slate-700">
												<input type="checkbox" name="send_days" value={ strconv.Itoa(d) } checked={ dayChecked(automation, d) }
													class="h-4 w-4 rounded text-indigo-600 focus:ring-indigo-500" />
												{ dayNames[d-1] }
											</label>
										}
									</div>
								</div>
								<div>
									<label for="sendTime" class="block text-sm font-medium text-slate-700">Send time</label>
									<input id="sendTime" name="send_time" type="time" value={ sendTimeValue(automation) }
										class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
								</div>
							</div>
							<div class="mt-4">
								<label for="sendTimezone" class="block text-sm font-medium text-slate-700">Timezone (IANA)</label>
								<input id="sendTimezone" name="send_timezone" type="text" value={ sendTimezoneValue(automation) }
									placeholder="e.g. Africa/Tunis, UTC"
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
							</div>
							<p class="mt-3 text-xs text-slate-500">
								An event arriving before the time waits until it; an event at or after it is sent
								immediately. On a day you didn't select, the send waits for the next selected day at the
								same time.
							</p>
						</div>

						<div id="delayedSchedule" class="hidden">
							<div class="sm:w-64">
								<label for="sendDelay" class="block text-sm font-medium text-slate-700">Delay after the event (minutes)</label>
								<input id="sendDelay" name="send_delay_minutes" type="number" min="1" max="20160" value={ delayValue(automation) }
									placeholder="e.g. 30"
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
							</div>
							<p class="mt-3 text-xs text-slate-500">The message is sent { delayValue(automation) } minutes after the event, even if the daily send time has passed.</p>
						</div>
					</div>

					<div class="flex items-center gap-3 pb-6">
						<button type="submit"
							class="rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700">
							if isEdit {
								Save
							} else {
								Create automation
							}
						</button>
						<a href="/automations" class="rounded-lg px-4 py-2 text-sm font-medium text-slate-500 transition hover:text-slate-700">Cancel</a>
					</div>
				</div>

				<aside class="lg:col-span-1">
					<div class="sticky top-6 rounded-xl border border-slate-200 bg-[#edf6ff] p-5">
						<div class="text-sm font-semibold text-slate-800">Message preview</div>
						<div class="mt-1 text-xs text-slate-500">What the customer will receive</div>
						<div id="previewBody" class="mt-3 min-h-20 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
							Select a template to preview.
						</div>
						<div class="mt-3 text-xs text-slate-500">
							The template variables ({"{{1}}"} customer, {"{{2}}"} order, {"{{3}}"} status) are
							filled automatically when the message is sent.
						</div>
					</div>
				</aside>
			</form>
		</div>

		<script>
			(function () {
				var catalog = {};
				var currentShop = document.getElementById("shopSelect");
				var select = document.getElementById("templateSelect");
				var preview = document.getElementById("previewBody");

				if (currentShop && select && preview) {
					function renderPreview() {
						var t = catalog[select.value];
						if (t) {
							preview.textContent = t.body || "Select a template to preview.";
						} else {
							preview.textContent = "Select a template to preview.";
						}
					}

					function rebuild(copySelection) {
						var previous = select.value;
						select.innerHTML = "";
						var placeholder = document.createElement("option");
						placeholder.value = "";
						placeholder.disabled = true;
						placeholder.selected = true;
						placeholder.textContent = "Choose a template…";
						select.appendChild(placeholder);
						for (var id in catalog) {
							if (!catalog.hasOwnProperty(id)) { continue; }
							var t = catalog[id];
							var opt = document.createElement("option");
							opt.value = id;
							opt.textContent = t.name + " (" + t.language + ")" + (t.shop ? " · " + t.shop : "");
							select.appendChild(opt);
						}
						if (copySelection && previous && catalog[previous]) {
							select.value = previous;
						}
						renderPreview();
					}

					function loadTemplates(shopID) {
						fetch("/automations/shops/" + encodeURIComponent(shopID) + "/templates", {
							headers: { "Accept": "application/json" }
						}).then(function (resp) {
							return resp.ok ? resp.json() : Promise.reject(resp.status);
						}).then(function (data) {
							catalog = {};
							(data.templates || []).forEach(function (t) {
								catalog[t.id] = { name: t.name, language: t.language, body: t.body, shop: t.shop || "" };
							});
							rebuild(true);
						}).catch(function (err) {
							console.warn("template catalog load failed", err);
						});
					}

					select.addEventListener("change", renderPreview);
					currentShop.addEventListener("change", function () {
						select.value = "";
						loadTemplates(currentShop.value);
					});

					// Prime the JS catalog so switching shops works and the
					// preview matches the server-side selected template.
					loadTemplates(currentShop.value);
				}

				var modeInputs = document.querySelectorAll("input[name=send_mode]");
				var fixed = document.getElementById("fixedSchedule");
				var delayed = document.getElementById("delayedSchedule");
				if (modeInputs.length && fixed && delayed) {
					function syncMode() {
						var value = null;
						for (var i = 0; i < modeInputs.length; i++) {
							if (modeInputs[i].checked) { value = modeInputs[i].value; break; }
						}
						fixed.classList.toggle("hidden", value !== "fixed");
						delayed.classList.toggle("hidden", value !== "delayed");
					}
					for (var i = 0; i < modeInputs.length; i++) {
						modeInputs[i].addEventListener("change", syncMode);
					}
					syncMode();
				}

				var source = document.getElementById("eventSource");
				var conv = document.getElementById("convertyTrigger");
				var del = document.getElementById("deliveryTrigger");
				var status = document.getElementById("eventStatus");
				var statusDel = document.getElementById("eventStatusDelivery");
				if (source && conv && del && status && statusDel) {
					function syncSource() {
						if (source.value === "delivery") {
							conv.classList.add("hidden");
							del.classList.remove("hidden");
							status.required = false;
							statusDel.name = "event_status";
						} else {
							del.classList.add("hidden");
							conv.classList.remove("hidden");
							status.required = true;
							statusDel.name = "event_status_delivery";
						}
					}
					source.addEventListener("change", syncSource);
					syncSource();
				}
			})();
		</script>
	}
}

func formAction(a *automations.Automation) string {
	if a == nil {
		return "/automations"
	}
	return "/automations/" + a.ID.String() + "/update"
}

func automationName(a *automations.Automation) string {
	if a == nil {
		return ""
	}
	return a.Name
}

func automationDescription(a *automations.Automation) string {
	if a == nil {
		return ""
	}
	return a.Description
}

func automationEventSource(a *automations.Automation) string {
	if a == nil || a.EventSource == "" {
		return "converty"
	}
	return a.EventSource
}

func automationStatus(a *automations.Automation) string {
	if a == nil {
		return ""
	}
	return a.OrderStatus
}

func automationTemplateID(a *automations.Automation) uuid.UUID {
	if a == nil {
		return uuid.Nil
	}
	return a.TemplateID
}

// shopSelected reports whether a shop is the form's current target: the edited
// automation's own shop, or the first integrated shop when creating.
func shopSelected(a *automations.Automation, shop shops.Shop, page components.Page) bool {
	if a != nil {
		return a.ShopID == shop.ID
	}
	return len(page.Shops) > 0 && page.Shops[0].ID == shop.ID
}

func sendTimezoneValue(a *automations.Automation) string {
	if a == nil || a.SendTimezone == "" {
		return "UTC"
	}
	return a.SendTimezone
}

// templateOptionLabel renders a shared-template dropdown entry with its owning
// shop so automations can tell templates apart across stores.
func templateOptionLabel(t whatsapp.MerchantTemplate, templateShops map[uuid.UUID]string) string {
	label := t.Name + " (" + t.Language + ")"
	if shop := templateShops[t.ShopID]; shop != "" {
		label += " · " + shop
	}
	return label
}