package viewsdashboard

import (
	"fmt"
	"slices"
	"strconv"
	"time"

	"github.com/google/uuid"

	"whatsappconverty/internal/automations"
	"whatsappconverty/internal/shops"
	"whatsappconverty/internal/whatsapp"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

templ AutomationFormPage(page components.Page, automation *automations.Automation, templates []whatsapp.MerchantTemplate, templateShops map[uuid.UUID]string, deliveryStatuses []string, isEdit bool, flash AutomationFlash, source string, sourceCounts map[string]int) {
	@layouts.Shell(page) {
		<div class="mx-auto max-w-6xl">
			<div class="flex items-center justify-between">
				<div>
					<h2 class="text-2xl font-bold text-slate-900">
						if isEdit {
							{ page.T("form.editAutomation") }
						} else {
							{ page.T("form.newAutomation") }
						}
					</h2>
					<p class="mt-1 text-sm text-slate-500">
						{ page.T("form.templateHint") }
					</p>
				</div>
				<a href="/automations" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-50">{ page.T("form.back") }</a>
			</div>

			if flash.Error != "" {
				<div class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{ flash.Error }</div>
			}

			<form method="post" action={ templ.SafeURL(formAction(automation)) } class="mt-6 grid gap-6 lg:grid-cols-3"
				data-automation-form
				data-converty-count={ strconv.Itoa(sourceCounts["converty"]) }
				data-delivery-count={ strconv.Itoa(sourceCounts["delivery"]) }>
				<div class="space-y-6 lg:col-span-2">
					<div class="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
						<div class="grid gap-4 sm:grid-cols-2">
							<div>
								<label for="name" class="block text-sm font-medium text-slate-700">{ page.T("form.name") }</label>
								<input id="name" name="name" type="text" required value={ automationName(automation) }
									placeholder={ page.T("form.namePlaceholder") }
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
							</div>
							<div>
								<label for="description" class="block text-sm font-medium text-slate-700">{ page.T("form.description") }</label>
								<input id="description" name="description" type="text" value={ automationDescription(automation) }
									placeholder={ page.T("form.descriptionPlaceholder") }
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
							</div>
						</div>

						<div>
							<label class="block text-sm font-medium text-slate-700">{ page.T("form.sendType") }</label>
							<div class="mt-2 flex flex-col gap-2">
								<label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700">
									<input type="radio" name="send_mode" value="instant" checked={ selectedMode(automation) == "instant" }
										class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" />
									{ page.T("form.modeInstant") }
								</label>
								<label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700">
									<input type="radio" name="send_mode" value="fixed" checked={ selectedMode(automation) == "fixed" }
										class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" />
									{ page.T("form.modeFixed") }
								</label>
								<label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700">
									<input type="radio" name="send_mode" value="delayed" checked={ selectedMode(automation) == "delayed" }
										class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" />
									{ page.T("form.modeDelayed") }
								</label>
							</div>
						</div>
					</div>

					<div class="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
						<div class="grid gap-4 sm:grid-cols-3">
							<div>
								<label class="block text-sm font-medium text-slate-700">{ page.T("form.shop") }</label>
								<select id="shopSelect" name="shop_id"
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
									for _, s := range page.Shops {
										<option value={ s.ID.String() } selected={ shopSelected(automation, s, page) }>{ s.Name }</option>
									}
								</select>
							</div>
							<div>
								<label for="eventSource" class="block text-sm font-medium text-slate-700">{ page.T("form.eventSource") }</label>
								<select id="eventSource" name="event_source"
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
									<option value="converty" selected={ source == "converty" }>{ page.T("form.sourceOrder") }</option>
									<option value="delivery" selected={ source == "delivery" }>{ page.T("form.sourceDelivery") }</option>
								</select>
							</div>
							<div id="convertyTrigger" class={ triggerClass(source, "converty") }>
								<label for="eventStatus" class="block text-sm font-medium text-slate-700">{ page.T("form.triggerOn") }</label>
								<select id="eventStatus" name="event_status" required disabled={ source == "delivery" }
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
									<option value="" disabled selected={ automationStatus(automation) == "" }>{ page.T("form.chooseStatus") }</option>
									for _, s := range automations.ConvertyStatuses() {
										<option value={ s } selected={ automationStatus(automation) == s }>{ s }</option>
									}
								</select>
							</div>
							<div id="deliveryTrigger" class={ triggerClass(source, "delivery") }>
								<label for="eventStatusDelivery" class="block text-sm font-medium text-slate-700">{ page.T("form.triggerOn") }</label>
								<select id="eventStatusDelivery" name={ deliveryStatusField(source) } disabled={ source != "delivery" } class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
									<option value="" disabled selected={ automationStatus(automation) == "" }>{ page.T("form.chooseStatus") }</option>
									for _, s := range deliveryStatuses {
										<option value={ s } selected={ automationStatus(automation) == s }>{ s }</option>
									}
								</select>
							</div>
						</div>
					</div>

					<div class="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
						<label for="templateSelect" class="block text-sm font-medium text-slate-700">{ page.T("form.approvedTemplate") }</label>
						if sourceCounts[source] == 0 {
							<p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
								if sourceCounts[otherSource(source)] > 0 {
									{ page.T("form.noTemplateOther") }
								} else {
									{ page.T("form.noTemplateAny") }
								}
							</p>
						}
						if len(templates) == 0 {
							<div class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
								{ page.T("form.noTemplateShop") }
							</div>
						} else {
							<select id="templateSelect" name="template_id" required
								class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
								<option value="" disabled selected={ automation == nil && automationTemplateID(automation) == uuid.Nil }>{ page.T("form.chooseTemplate") }</option>
								for _, t := range templates {
									<option value={ t.ID.String() } selected={ automationTemplateID(automation) == t.ID }>{ templateOptionLabel(t, templateShops) }</option>
								}
							</select>
						}
					</div>

					<div class="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
						<h3 class="text-sm font-semibold text-slate-700">{ page.T("form.scheduleSettings") }</h3>

						<div id="fixedSchedule" class={ scheduleClass(automation, "fixed") }
							x-data="{
								tz: 'Africa/Tunis',
								time: '00:00',
								fmt() {
									var args = Array.prototype.slice.call(arguments);
									var s = args.shift();
									return s.replace(/%s/g, function () { return args.shift() || ''; });
								},
								tick() {
									try {
										var clock = new Intl.DateTimeFormat(undefined, {
											hour: '2-digit', minute: '2-digit', timeZone: this.tz
										}).format(new Date());
										this.now = this.fmt(window.automationFormI18N.clockNow,
											clock, this.tz, this.time || '00:00', this.time || '00:00');
									} catch (err) {
										this.now = this.fmt(window.automationFormI18N.clockUnreadable, this.tz);
									}
								}
							}" x-init="tick()">
							<div class="grid gap-4 sm:grid-cols-2">
								<div>
									<label class="block text-sm font-medium text-slate-700">{ page.T("form.sendDays") }</label>
									<div class="mt-2 grid grid-cols-4 gap-2">
										for d := 1; d <= 7; d++ {
											<label class="flex cursor-pointer items-center gap-1.5 text-sm text-slate-700">
												<input type="checkbox" name="send_days" value={ strconv.Itoa(d) } checked={ dayChecked(automation, d) } disabled={ selectedMode(automation) != "fixed" }
													class="h-4 w-4 rounded text-indigo-600 focus:ring-indigo-500" />
												{ page.T("automations.day." + dayNames[d-1]) }
											</label>
										}
									</div>
								</div>
								<div>
									<label for="sendTime" class="block text-sm font-medium text-slate-700">{ page.T("form.sendTime") }</label>
									<input id="sendTime" name="send_time" type="time" value={ sendTimeValue(automation) } disabled={ selectedMode(automation) != "fixed" }
										x-model="time" @input="tick()"
											class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
								</div>
							</div>
							<div class="mt-4">
								<label for="sendTimezone" class="block text-sm font-medium text-slate-700">{ page.T("form.timezone") }</label>
								<select id="sendTimezone" name="send_timezone" x-model="tz" @change="tick()" disabled={ selectedMode(automation) != "fixed" }
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
									for _, zone := range timezoneOptions(automation) {
										<option value={ zone.Name } selected={ zone.Name == sendTimezoneValue(automation) }>{ zone.Label }</option>
									}
								</select>
								<p class="mt-2 text-xs text-slate-500" x-text="now"></p>
							</div>
							<p class="mt-3 text-xs text-slate-500">
								{ page.T("form.fixedHint") }
							</p>
						</div>

						<div id="delayedSchedule" class={ scheduleClass(automation, "delayed") }>
							<div class="sm:w-64">
								<label for="sendDelay" class="block text-sm font-medium text-slate-700">{ page.T("form.delayAfter") }</label>
								<input id="sendDelay" name="send_delay_minutes" type="number" min="1" max="20160" value={ delayInputValue(automation) } disabled={ selectedMode(automation) != "delayed" }
									placeholder="e.g. 30"
									class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
							</div>
							<p class="mt-3 text-xs text-slate-500">{ page.Tf("form.delayHint", delayHint(automation)) }</p>
						</div>
					</div>

					<div class="flex flex-wrap items-center gap-3 pb-6">
						<button type="submit" id="automationSubmit"
							class="rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700">
							if isEdit {
								{ page.T("form.save") }
							} else {
								{ page.T("form.create") }
							}
						</button>
						<a href="/automations" class="rounded-lg px-4 py-2 text-sm font-medium text-slate-500 transition hover:text-slate-700">{ page.T("common.cancel") }</a>
						<p id="automationProblem" class="hidden w-full rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800"></p>
					</div>
				</div>

				<aside class="lg:col-span-1">
					<div class="sticky top-6 rounded-xl border border-slate-200 bg-[#edf6ff] p-5">
						<div class="text-sm font-semibold text-slate-800">{ page.T("form.previewTitle") }</div>
						<div class="mt-1 text-xs text-slate-500">{ page.T("form.previewCaption") }</div>
						<div id="previewBody" class="mt-3 min-h-20 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
							{ page.T("form.previewEmpty") }
						</div>
						<div class="mt-3 text-xs text-slate-500">
							{ page.T("form.previewHint") }
						</div>
					</div>
				</aside>
			</form>
		</div>

<script>
window.automationFormI18N = { !automationFormMessages(page.I18N) };
window.automationFormFmt = function () {
	var args = Array.prototype.slice.call(arguments);
	var s = args.shift();
	return s.replace(/%s/g, function () { return args.shift() || ''; });
};
</script>

<script>
// The form's behaviour is plain DOM on purpose: panels, validation and the
// template catalog must not depend on a framework layer booting, or a dead
// submit looks like a dead button.
(function () {
	var form = document.querySelector("form[data-automation-form]");
	if (!form) { return; }

	var source = document.getElementById("eventSource");
	var shop = document.getElementById("shopSelect");
	var conv = document.getElementById("convertyTrigger");
	var del = document.getElementById("deliveryTrigger");
	var status = document.getElementById("eventStatus");
	var statusDel = document.getElementById("eventStatusDelivery");
	var fixed = document.getElementById("fixedSchedule");
	var delayed = document.getElementById("delayedSchedule");
	var sendTime = document.getElementById("sendTime");
	var sendTimezone = document.getElementById("sendTimezone");
	var sendDelay = document.getElementById("sendDelay");
	var select = document.getElementById("templateSelect");
	var preview = document.getElementById("previewBody");
	var problem = document.getElementById("automationProblem");
	var catalog = {};

	function mode() {
		var checked = form.querySelector("input[name=send_mode]:checked");
		return checked ? checked.value : "instant";
	}

	function dayCount() {
		return form.querySelectorAll("input[name=send_days]:checked").length;
	}

	// Hidden fields must be disabled, not just invisible: a control that fails
	// validation inside a display:none panel is skipped by the browser, so the
	// submit is refused and the only trace is a console line pointing at a field
	// the user cannot see. Disabling also keeps them out of the POST body.
	function setHidden(el, hidden) {
		if (!el) { return; }
		el.classList.toggle("hidden", hidden);
		var fields = el.querySelectorAll("input, select, textarea");
		for (var i = 0; i < fields.length; i++) { fields[i].disabled = hidden; }
	}

	function syncSource() {
		var delivery = source && source.value === "delivery";
		setHidden(conv, delivery);
		setHidden(del, !delivery);
		if (status && statusDel) {
			status.required = !delivery;
			statusDel.name = delivery ? "event_status" : "event_status_delivery";
		}
	}

	function syncMode() {
		var value = mode();
		setHidden(fixed, value !== "fixed");
		setHidden(delayed, value !== "delayed");
	}

	function templateProblem() {
		var counts = {
			converty: parseInt(form.dataset.convertyCount || "0", 10),
			delivery: parseInt(form.dataset.deliveryCount || "0", 10)
		};
		var current = source ? source.value : "converty";
		if (counts[current] > 0) { return ""; }
		var other = current === "delivery" ? "Converty" : "delivery";
		if (counts[other] > 0) {
			return window.automationFormFmt(window.automationFormI18N.noTemplateOther, other);
		}
		return window.automationFormI18N.noTemplateAny;
	}

	function scheduleProblem() {
		if (mode() === "fixed") {
			if (!sendTime || !sendTime.value) { return window.automationFormI18N.needTime; }
			if (dayCount() === 0) { return window.automationFormI18N.needDay; }
			if (sendTimezone && !sendTimezone.value.trim()) { return window.automationFormI18N.needTz; }
		}
		if (mode() === "delayed") {
			var delay = sendDelay ? parseInt(sendDelay.value, 10) : 0;
			if (!delay || delay < 1) { return window.automationFormI18N.needDelay; }
		}
		return "";
	}

	function problems() {
		return [templateProblem(), scheduleProblem()].filter(Boolean).join(" ");
	}

	// The button is never disabled: a control that silently refuses to submit is
	// indistinguishable from a broken page. The reason is shown next to the button,
	// an incomplete submit is held back here, and the server re-checks everything
	// and flashes the field that is wrong.
	function validate() {
		var message = problems();
		if (problem) {
			problem.textContent = message;
			problem.classList.toggle("hidden", message === "");
		}
		return message;
	}

	function renderPreview() {
		if (!preview || !select) { return; }
		var t = catalog[select.value];
		preview.textContent = t && t.body ? t.body : window.automationFormI18N.preview;
	}

	function rebuild(keepSelection) {
		if (!select) { return; }
		var previous = select.value;
		select.innerHTML = "";
		var placeholder = document.createElement("option");
		placeholder.value = "";
		placeholder.disabled = true;
		placeholder.selected = true;
		placeholder.textContent = window.automationFormI18N.chooseTemplate;
		select.appendChild(placeholder);
		for (var id in catalog) {
			if (!catalog.hasOwnProperty(id)) { continue; }
			var t = catalog[id];
			var opt = document.createElement("option");
			opt.value = id;
			opt.textContent = t.name + " (" + t.language + ")" + (t.shop ? " \u00b7 " + t.shop : "");
			select.appendChild(opt);
		}
		if (keepSelection && previous && catalog[previous]) { select.value = previous; }
		renderPreview();
		validate();
	}

	// The catalog is source-specific: a message written for Mes Colis cannot
	// serve a Converty trigger, so the list is refetched when shop or source
	// changes.
	function loadTemplates() {
		if (!select || !shop) { return; }
		var shopID = shop.value;
		var kind = source ? source.value : "converty";
		fetch("/automations/shops/" + encodeURIComponent(shopID) + "/templates?source=" + encodeURIComponent(kind), {
			headers: { "Accept": "application/json" }
		}).then(function (resp) {
			return resp.ok ? resp.json() : Promise.reject(resp.status);
		}).then(function (data) {
			catalog = {};
			(data.templates || []).forEach(function (t) {
				catalog[t.id] = { name: t.name, language: t.language, body: t.body, shop: t.shop || "" };
			});
			rebuild(true);
		}).catch(function (err) {
			console.warn("template catalog load failed", err);
		});
	}

	form.addEventListener("change", function (evt) {
		var target = evt.target;
		if (!target) { return; }
		if (target.name === "send_mode") { syncMode(); }
		if (target.id === "eventSource") { syncSource(); loadTemplates(); }
		if (target.id === "shopSelect") { loadTemplates(); }
		if (target.id === "templateSelect") { renderPreview(); }
		validate();
	});
	form.addEventListener("input", function () { validate(); });
	form.addEventListener("submit", function (evt) {
		if (validate() !== "") { evt.preventDefault(); }
	});

	syncSource();
	syncMode();
	loadTemplates();
	validate();
})();
		</script>
	}
}

func formAction(a *automations.Automation) string {
	if a == nil {
		return "/automations"
	}
	return "/automations/" + a.ID.String() + "/update"
}

func automationName(a *automations.Automation) string {
	if a == nil {
		return ""
	}
	return a.Name
}

func automationDescription(a *automations.Automation) string {
	if a == nil {
		return ""
	}
	return a.Description
}

func automationEventSource(a *automations.Automation) string {
	if a == nil || a.EventSource == "" {
		return "converty"
	}
	return a.EventSource
}

func automationStatus(a *automations.Automation) string {
	if a == nil {
		return ""
	}
	return a.OrderStatus
}

func automationTemplateID(a *automations.Automation) uuid.UUID {
	if a == nil {
		return uuid.Nil
	}
	return a.TemplateID
}

// shopSelected reports whether a shop is the form's current target: the edited
// automation's own shop, or the first integrated shop when creating.
func shopSelected(a *automations.Automation, shop shops.Shop, page components.Page) bool {
	if a != nil {
		return a.ShopID == shop.ID
	}
	return len(page.Shops) > 0 && page.Shops[0].ID == shop.ID
}

func sendTimezoneValue(a *automations.Automation) string {
	if a == nil || a.SendTimezone == "" {
		return automations.DefaultTimezone
	}
	return a.SendTimezone
}

type timezoneOption struct {
	Name  string
	Label string
}

// timezoneOptions builds the dropdown for the chosen schedule. A zone saved
// before this list existed is put first and kept selected, so opening the form
// to change something else does not quietly rewrite the timezone behind the
// merchant's back.
func timezoneOptions(a *automations.Automation) []timezoneOption {
	chosen := sendTimezoneValue(a)
	seen := make(map[string]bool, len(automations.Timezones)+1)
	out := make([]timezoneOption, 0, len(automations.Timezones)+1)
	add := func(name string) {
		if seen[name] {
			return
		}
		seen[name] = true
		out = append(out, timezoneOption{Name: name, Label: timezoneLabel(name)})
	}
	if !slices.Contains(automations.Timezones, chosen) {
		add(chosen)
	}
	for _, zone := range automations.Timezones {
		add(zone)
	}
	return out
}

// timezoneLabel shows the zone's current UTC offset. "10:00" is ambiguous without
// it: Africa/Tunis is UTC+1 year-round, so a 10:00 rule set to UTC fires at 11:00
// on the clock in front of the merchant.
func timezoneLabel(name string) string {
	loc, err := time.LoadLocation(name)
	if err != nil {
		return name
	}
	_, offset := time.Now().In(loc).Zone()
	sign := "+"
	if offset < 0 {
		sign = "-"
		offset = -offset
	}
	hours := offset / 3600
	minutes := (offset % 3600) / 60
	if minutes == 0 {
		return fmt.Sprintf("%s (UTC%s%d)", name, sign, hours)
	}
	return fmt.Sprintf("%s (UTC%s%d:%02d)", name, sign, hours, minutes)
}

// templateOptionLabel renders a shared-template dropdown entry with its owning
// shop so automations can tell templates apart across stores.
func templateOptionLabel(t whatsapp.MerchantTemplate, templateShops map[uuid.UUID]string) string {
	label := t.Name + " (" + t.Language + ")"
	if shop := templateShops[t.ShopID]; shop != "" {
		label += " · " + shop
	}
	return label
}
// triggerClass shows the trigger panel the chosen event source uses, so the
// form is coherent before Alpine boots (and without JS at all).
func triggerClass(source, want string) string {
	if source == want {
		return "block"
	}
	return "block hidden"
}

// deliveryStatusField posts the visible status select under the name the
// server reads, whichever source is active.
func deliveryStatusField(source string) string {
	if source == "delivery" {
		return "event_status"
	}
	return "event_status_delivery"
}

// scheduleClass shows the panel of the automation's send mode.
func scheduleClass(a *automations.Automation, want string) string {
	if selectedMode(a) == want {
		return "block"
	}
	return "block hidden"
}

// otherSource is the source to suggest when the chosen one has no template.
func otherSource(source string) string {
	if source == "delivery" {
		return "converty"
	}
	return "delivery"
}
