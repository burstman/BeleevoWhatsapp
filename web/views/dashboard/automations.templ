package viewsdashboard

import (
	"fmt"
	"strings"

	"github.com/google/uuid"

	"whatsappconverty/internal/automations"
	"whatsappconverty/internal/whatsapp"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

type AutomationFlash struct {
	Error string
	Info  string
}

func typeLabel(a automations.Automation) string {
	if a.DelayMinutes != nil {
		return "Retardée"
	}
	if a.SendTime != nil {
		return "Programmée"
	}
	return "Instantanée"
}

func typeDetail(a automations.Automation) string {
	if a.DelayMinutes != nil {
		return fmt.Sprintf("%d min après l'événement", *a.DelayMinutes)
	}
	if a.SendTime != nil {
		tz := a.SendTimezone
		if tz == "" {
			tz = "UTC"
		}
		return fmt.Sprintf("%02d:%02d · %s", a.SendTime.Hour(), a.SendTime.Minute(), tz)
	}
	return ""
}

var dayNames = [7]string{"Lun", "Mar", "Mer", "Jeu", "Ven", "Sam", "Dim"}

func daysLabel(days []int) string {
	if len(days) == 0 {
		return "Tous les jours"
	}
	if len(days) == 7 {
		return "Tous les jours"
	}
	var parts []string
	for _, d := range days {
		if d >= 1 && d <= 7 {
			parts = append(parts, dayNames[d-1])
		}
	}
	return strings.Join(parts, ", ")
}

func dayChecked(a *automations.Automation, weekday int) bool {
	if a == nil {
		return true
	}
	for _, d := range a.SendDays {
		if d == weekday {
			return true
		}
	}
	return false
}

func sendTimeValue(a *automations.Automation) string {
	if a == nil || a.SendTime == nil {
		return ""
	}
	return fmt.Sprintf("%02d:%02d", a.SendTime.Hour(), a.SendTime.Minute())
}

func delayValue(a *automations.Automation) int {
	if a == nil || a.DelayMinutes == nil {
		return 0
	}
	return *a.DelayMinutes
}

func selectedMode(a *automations.Automation) string {
	if a == nil {
		return "instant"
	}
	if a.DelayMinutes != nil {
		return "delayed"
	}
	if a.SendTime != nil {
		return "fixed"
	}
	return "instant"
}

templ automationCardBody(a automations.Automation, templateNames map[uuid.UUID]string, templateBodies map[uuid.UUID]string) {
	<div class="p-5">
		<div class="flex items-start justify-between gap-4">
			<div>
				<div class="flex items-center gap-2">
					<span class="text-base font-bold text-slate-900">{ a.Name }</span>
					if a.Enabled {
						<span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">Activé</span>
					} else {
						<span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">En pause</span>
					}
				</div>
				if a.Description != "" {
					<div class="mt-1 text-sm text-slate-500">{ a.Description }</div>
				}
			</div>
			<div class="flex items-center gap-2">
				<form method="post" action={ templ.SafeURL("/automations/" + a.ID.String() + "/toggle") }
					onsubmit="return true">
					if a.Enabled {
						<input type="hidden" name="enabled" value="0" />
						<button type="submit"
							class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50">Pause</button>
					} else {
						<input type="hidden" name="enabled" value="1" />
						<button type="submit"
							class="rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-sm font-medium text-indigo-700 transition hover:bg-indigo-100">Activer</button>
					}
				</form>
				<a href={ templ.SafeURL("/automations/" + a.ID.String() + "/edit") }
					class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50">Modifier</a>
				<form method="post" action={ templ.SafeURL("/automations/" + a.ID.String() + "/delete") }
					onsubmit="return confirm('Supprimer cette automation ?')">
					<button type="submit"
						class="rounded-lg px-3 py-1.5 text-sm font-medium text-rose-600 transition hover:bg-rose-50">Supprimer</button>
				</form>
			</div>
		</div>

		<div class="mt-4 grid grid-cols-2 gap-4 border-y border-slate-100 py-3 lg:grid-cols-4">
			<div>
				<div class="text-xs font-medium uppercase tracking-wide text-slate-400">Type</div>
				<div class="mt-1 text-sm font-medium text-slate-700">{ typeLabel(a) }</div>
				if a.SendTime != nil && len(a.SendDays) > 0 {
					<div class="text-xs text-slate-400">{ daysLabel(a.SendDays) }</div>
				}
				<div class="text-xs text-slate-400">{ typeDetail(a) }</div>
			</div>
			<div>
				<div class="text-xs font-medium uppercase tracking-wide text-slate-400">Déclencheur</div>
				<div class="mt-1">
					<span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700">{ automations.SourceLabel(a.EventSource) }</span>
				</div>
				<div class="mt-1 text-sm font-semibold text-slate-900">{ a.OrderStatus }</div>
			</div>
			<div>
				<div class="text-xs font-medium uppercase tracking-wide text-slate-400">Template</div>
				if a.TemplateID == uuid.Nil {
					<div class="mt-1">
						<span class="inline-flex items-center rounded-full bg-rose-50 px-2 py-0.5 text-xs font-medium text-rose-600">Supprimé</span>
					</div>
				} else {
					<div class="mt-1">
						<span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">Approuvé</span>
					</div>
					<div class="mt-1 text-sm font-medium text-slate-900">{ templateNames[a.TemplateID] }</div>
				}
			</div>
			<div>
				<div class="text-xs font-medium uppercase tracking-wide text-slate-400">Message</div>
				<div class="mt-1 truncate text-sm text-slate-500">{ templateBodies[a.TemplateID] }</div>
			</div>
		</div>
	</div>
}

templ AutomationsPage(page components.Page, list []automations.Automation, templates []whatsapp.MerchantTemplate, templateNames map[uuid.UUID]string, templateBodies map[uuid.UUID]string, deliveryStatuses []string, flash AutomationFlash) {
	@layouts.Shell(page) {
		<div class="space-y-6">
			<div class="flex items-center justify-between gap-4">
				<div>
					<h2 class="text-2xl font-bold text-slate-900">Automations</h2>
					<p class="mt-1 text-sm text-slate-500">
						Chaque automation envoie un template approuvé quand un événement se produit —
						Instantané, à heure fixe ou après un délai.
					</p>
				</div>
				<a href="/automations/new"
					class="inline-flex shrink-0 items-center gap-2 rounded-lg border border-amber-300 bg-amber-100 px-4 py-2 text-sm font-semibold text-amber-900 transition hover:bg-amber-200">
					Nouvelle automation
				</a>
			</div>

			if flash.Error != "" {
				<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{ flash.Error }</div>
			}
			if flash.Info != "" {
				<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">{ flash.Info }</div>
			}

			if len(list) == 0 {
				<div class="rounded-xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
					<div class="text-sm font-semibold text-slate-700">Aucune automation</div>
					<div class="mt-1 text-sm text-slate-500">
						Créez la première — par exemple un événement "delivered" qui envoie votre template
						order_delivered à 10h00.
					</div>
					<a href="/automations/new"
						class="mt-4 inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
						Creer une automation
					</a>
				</div>
			} else {
				for _, a := range list {
					<div class={ templ.SafeClass(borderClass(a.Enabled)) }>
						@automationCardBody(a, templateNames, templateBodies)
					</div>
				}
			}
		</div>
	}
}

func borderClass(enabled bool) string {
	if enabled {
		return "rounded-xl border border-slate-200 border-l-4 border-l-emerald-500 bg-white shadow-sm"
	}
	return "rounded-xl border border-slate-200 border-l-4 border-l-slate-300 bg-white shadow-sm"
}