package viewsdashboard

import (
	"fmt"

	"github.com/google/uuid"

	"whatsappconverty/internal/automations"
	"whatsappconverty/internal/whatsapp"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

type AutomationFlash struct {
	Error string
	Info  string
}

// automationStatusLabel renders the trigger key with a friendly origin label.
templ triggerCell(a automations.Automation) {
	<div>
		<span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700">{ automations.SourceLabel(a.EventSource) }</span>
		<span class="mt-1 block text-sm font-medium text-slate-900">{ a.OrderStatus }</span>
	</div>
}

func scheduleLabel(a automations.Automation) string {
	sch := a.Schedule()
	if sch == nil || sch.SendMinute == nil {
		return "Instant"
	}
	h := *sch.SendMinute / 60
	m := *sch.SendMinute % 60
	tz := sch.Timezone
	if tz == "" {
		tz = "UTC"
	}
	return fmt.Sprintf("%02d:%02d (%s)", h, m, tz)
}

templ AutomationsPage(page components.Page, list []automations.Automation, templates []whatsapp.MerchantTemplate, templateNames map[uuid.UUID]string, deliveryStatuses []string, flash AutomationFlash) {
	@layouts.Shell(page) {
		<div class="space-y-6">
			<div>
				<h2 class="text-xl font-semibold text-slate-900">Automations</h2>
				<p class="text-sm text-slate-500">
					Map an order event — from Converty or from your delivery provider — to an approved
					template, and the platform sends it automatically.
				</p>
			</div>

			if flash.Error != "" {
				<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{ flash.Error }</div>
			}
			if flash.Info != "" {
				<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">{ flash.Info }</div>
			}

			<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
				<div class="flex items-center justify-between">
					<div>
						<h3 class="text-sm font-semibold text-slate-700">New automation</h3>
						<p class="mt-1 text-xs text-slate-500">
							Trigger <span class="font-medium">once per order / parcel</span> — a send is
							recorded and a retried webhook will never double-send.
						</p>
					</div>
					<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">UTILITY</span>
				</div>

				<form method="post" action="/automations" class="mt-4 space-y-3">
					<div class="grid gap-3 sm:grid-cols-3">
						<div>
							<label for="eventSource" class="block text-xs font-medium text-slate-600">Event source</label>
							<select id="eventSource" name="event_source" required
								class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
								<option value="converty">Order event (Converty)</option>
								<option value="delivery">Delivery event (provider)</option>
							</select>
						</div>
						<div id="convertyTrigger">
							<label for="eventStatus" class="block text-xs font-medium text-slate-600">Order status to trigger on</label>
							<input id="eventStatus" name="event_status" required list="convertyStatuses"
								placeholder="e.g. pending, confirmed, shipped, cancelled"
								class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
							<datalist id="convertyStatuses">
								<option value="pending"></option>
								<option value="confirmed"></option>
								<option value="shipped"></option>
								<option value="delivered"></option>
								<option value="cancelled"></option>
							</datalist>
						</div>
						<div id="deliveryTrigger" class="hidden">
							<label for="eventStatusDelivery" class="block text-xs font-medium text-slate-600">Delivery status to trigger on</label>
							<select id="eventStatusDelivery" name="event_status_delivery" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
								for _, s := range deliveryStatuses {
									<option value={ s }>{ s }</option>
								}
							</select>
						</div>
						<div>
							<label for="templateSelect" class="block text-xs font-medium text-slate-600">Template</label>
							<select id="templateSelect" name="template_id" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
								if len(templates) == 0 {
									<option value="">No approved templates yet</option>
								} else {
									for _, t := range templates {
										<option value={ t.ID.String() }>{ t.Name } ({ t.Language })</option>
									}
								}
							</select>
						</div>
					</div>

					<div class="grid gap-3 rounded-xl border border-slate-100 bg-slate-50/50 p-4 sm:grid-cols-3">
						<div>
							<label for="sendMode" class="block text-xs font-medium text-slate-600">Send time</label>
							<select id="sendMode" name="send_mode"
								class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
								<option value="instant">Instant — as soon as the event happens</option>
								<option value="fixed">Fixed time of day</option>
							</select>
						</div>
						<div id="fixedSend" class="hidden">
							<label for="sendTime" class="block text-xs font-medium text-slate-600">Send at (daily)</label>
							<input id="sendTime" name="send_time" type="time"
								class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
						</div>
						<div id="fixedTimezone" class="hidden">
							<label for="sendTimezone" class="block text-xs font-medium text-slate-600">Timezone (IANA)</label>
							<input id="sendTimezone" name="send_timezone" type="text" value="UTC" placeholder="e.g. UTC (default), Africa/Tunis"
								class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
						</div>
						<div class="sm:col-span-3">
							<p class="text-xs text-slate-500">
								An event arriving <span class="font-medium">before</span> the time waits until it;
								an event arriving <span class="font-medium">at or after</span> the time is sent right away.
							</p>
						</div>
					</div>

					<div class="flex items-center gap-3">
						<button type="submit"
							class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
							Create automation
						</button>
						<span class="text-xs text-slate-500">Variables: {"{{1}}"} customer, {"{{2}}"} order, {"{{3}}"} status</span>
					</div>
				</form>
			</div>

			<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
				<div class="border-b border-slate-100 px-6 py-4">
					<h3 class="text-sm font-semibold text-slate-700">Your automations</h3>
				</div>
				if len(list) == 0 {
					<div class="px-6 py-10 text-center text-sm text-slate-500">
						No automations yet. Create one above — for example "delivered" → your order_delivered template.
					</div>
				} else {
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
							<tr>
								<th class="px-6 py-3 font-medium">Trigger</th>
								<th class="px-6 py-3 font-medium">Template</th>
								<th class="px-6 py-3 font-medium">Send time</th>
								<th class="px-6 py-3 font-medium">Status</th>
								<th class="px-6 py-3 font-medium"></th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							for _, a := range list {
								<tr>
									<td class="px-6 py-3">
										@triggerCell(a)
									</td>
									<td class="px-6 py-3 font-medium text-slate-900">
										if a.TemplateID == uuid.Nil {
											<span class="text-slate-400">(template deleted)</span>
										} else {
											{ templateNames[a.TemplateID] }
										}
									</td>
									<td class="px-6 py-3 text-slate-600">
										if a.SendTime == nil {
											<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">Instant</span>
										} else {
											<span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">{ scheduleLabel(a) }</span>
										}
									</td>
									<td class="px-6 py-3">
										if a.Enabled {
											<span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">Active</span>
										} else {
											<span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">Paused</span>
										}
									</td>
									<td class="px-6 py-3">
										<div class="flex items-center justify-end gap-2">
											<form method="post" action={ templ.SafeURL("/automations/" + a.ID.String() + "/toggle") }>
												if a.Enabled {
													<input type="hidden" name="enabled" value="0" />
													<button type="submit" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50">Pause</button>
												} else {
													<input type="hidden" name="enabled" value="1" />
													<button type="submit" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50">Resume</button>
												}
											</form>
											<form method="post" action={ templ.SafeURL("/automations/" + a.ID.String() + "/delete") }
												onsubmit="return confirm('Delete this automation?')">
												<button type="submit" class="rounded-lg px-3 py-1.5 text-sm font-medium text-rose-600 transition hover:bg-rose-50">Delete</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		</div>

		<script>
			(function () {
				var source = document.getElementById("eventSource");
				var conv = document.getElementById("convertyTrigger");
				var del = document.getElementById("deliveryTrigger");
				var status = document.getElementById("eventStatus");
				var statusDel = document.getElementById("eventStatusDelivery");
				if (!source || !conv || !del || !status || !statusDel) return;
				function sync() {
					if (source.value === "delivery") {
						conv.classList.add("hidden");
						del.classList.remove("hidden");
						status.required = false;
						statusDel.name = "event_status";
					} else {
						del.classList.add("hidden");
						conv.classList.remove("hidden");
						status.required = true;
						statusDel.name = "event_status_delivery";
					}
				}
				source.addEventListener("change", sync);
				sync();

				var mode = document.getElementById("sendMode");
				var fixedTime = document.getElementById("fixedSend");
				var fixedTz = document.getElementById("fixedTimezone");
				var timeInput = document.getElementById("sendTime");
				var tzInput = document.getElementById("sendTimezone");
				if (!mode || !fixedTime || !fixedTz || !timeInput || !tzInput) return;
				function syncMode() {
					var isFixed = mode.value === "fixed";
					fixedTime.classList.toggle("hidden", !isFixed);
					fixedTz.classList.toggle("hidden", !isFixed);
					timeInput.disabled = !isFixed;
					tzInput.disabled = !isFixed;
				}
				mode.addEventListener("change", syncMode);
				syncMode();
			})();
		</script>
	}
}