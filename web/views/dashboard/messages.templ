package viewsdashboard

import (
	"strconv"

	"whatsappconverty/internal/whatsapp"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

templ MessagesPage(page components.Page, messages []whatsapp.Message, templates []whatsapp.MerchantTemplate) {
	@layouts.Shell(page) {
		<div class="space-y-6">
			<div>
				<h2 class="text-xl font-semibold text-slate-900">Messages</h2>
				<p class="text-sm text-slate-500">Delivery status reported by WhatsApp for messages sent through the platform number.</p>
			</div>

			<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
				<h3 class="text-sm font-semibold text-slate-700">Send a test message</h3>
				<p class="mt-1 text-xs text-slate-500">
					Uses an approved template through the platform number. The recipient must be a test number
					on the WhatsApp test list or in an open conversation.
				</p>
				<form id="sendTestForm" class="mt-4 space-y-3" onsubmit="return false">
					<div class="grid gap-3 sm:grid-cols-2">
						<div>
							<label for="testTemplate" class="block text-xs font-medium text-slate-600">Approved template</label>
							<select id="testTemplate" name="template_id" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
								if len(templates) == 0 {
									<option value="">No approved templates yet</option>
								} else {
									for _, t := range templates {
										<option value={ t.ID.String() } data-category={ t.Category } data-numvars={ strconv.Itoa(t.NumVariables) }>{ t.Name } · { t.Language } · { t.Category }</option>
									}
								}
							</select>
						</div>
						<div>
							<label for="testPhone" class="block text-xs font-medium text-slate-600">Recipient phone (E.164)</label>
							<input id="testPhone" name="phone" type="tel" placeholder="+21654116580" required
								class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
						</div>
					</div>
					<div class="flex items-center gap-3">
						<button type="submit"
							class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700 disabled:opacity-50">
							Send
						</button>
						<span id="testStatus" class="text-xs text-slate-500"></span>
					</div>
				</form>
			</div>

			<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
				if len(messages) == 0 {
					<div class="px-6 py-10 text-center text-sm text-slate-500">
						No messages sent yet.
					</div>
				} else {
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
							<tr>
								<th class="px-6 py-3 font-medium">Status</th>
								<th class="px-6 py-3 font-medium">To</th>
								<th class="px-6 py-3 font-medium">Order</th>
								<th class="px-6 py-3 font-medium">Template</th>
								<th class="px-6 py-3 font-medium">Sent</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							for _, m := range messages {
								<tr>
									<td class="px-6 py-3">
										@MessageStatusBadge(m.Status)
										if m.Status == "failed" && m.ErrorMessage != "" {
											<p class="mt-1 max-w-xs truncate text-xs text-rose-600" title={ m.ErrorMessage }>{ m.ErrorMessage }</p>
										}
									</td>
									<td class="px-6 py-3 text-slate-700">{ m.RecipientPhone }</td>
									<td class="px-6 py-3 text-slate-600">
										if m.ConvertyOrderID == "" {
											<span class="text-slate-400">—</span>
										} else {
											{ m.ConvertyOrderID }
										}
									</td>
									<td class="px-6 py-3 text-slate-600">
										if m.TemplateID == nil {
											<span class="text-slate-400">—</span>
										} else {
											<span class="font-mono text-xs">{ m.TemplateID.String() }</span>
										}
									</td>
									<td class="px-6 py-3 text-slate-600">
										if m.SentAt == nil {
											<span class="text-slate-400">—</span>
										} else {
											{ m.SentAt.Format("2006-01-02 15:04") }
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		</div>

		<script>
			(function () {
				var form = document.getElementById("sendTestForm");
				if (!form) return;
				var statusEl = document.getElementById("testStatus");
				var button = form.querySelector("button[type=submit]");

				function setStatus(msg, ok) {
					statusEl.textContent = msg;
					statusEl.className = "text-xs " + (ok ? "text-emerald-600" : "text-rose-600");
				}

				form.addEventListener("submit", function (e) {
					e.preventDefault();
					var sel = document.getElementById("testTemplate");
					var phone = document.getElementById("testPhone").value.trim();
					var templateId = sel.value;
					if (!templateId || !phone) { setStatus("Pick a template and enter a phone.", false); return; }

					var category = sel.options[sel.selectedIndex].getAttribute("data-category") || "";
					var numVars = parseInt(sel.options[sel.selectedIndex].getAttribute("data-numvars") || "0", 10) || 0;

					button.disabled = true;
					setStatus("Creating customer…", true);

					fetch("/api/whatsapp/customers", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ name: "Dashboard test", phone: phone })
					}).then(function (r) { return r.json(); }).then(function (customer) {
						setStatus("Recording consent…", true);
						return fetch("/api/whatsapp/consent", {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify({
								customer_id: customer.id,
								category: category,
								source: "dashboard",
								evidence: "manual test send from /messages"
							})
						}).then(function (r) {
							if (!r.ok) throw new Error("consent failed: " + r.status);
							return customer.id;
						});
					}).then(function (customerId) {
						var vars = {};
						for (var i = 1; i <= numVars; i++) { vars[String(i)] = "TEST-" + i; }
						setStatus("Sending through the platform number…", true);
						return fetch("/api/whatsapp/messages", {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify({
								customer_id: customerId,
								template_id: templateId,
								purpose: category,
								variables: vars,
								idempotency_key: "dash-" + Date.now() + "-" + Math.random().toString(36).slice(2, 8)
							})
						}).then(function (r) {
							if (!r.ok) { return r.json().then(function (body) { throw new Error(body.message || "send failed"); }); }
							return r.json();
						});
					}).then(function (res) {
						setStatus("Sent to WhatsApp (" + res.status + "). Reloading…", true);
						button.disabled = false;
						setTimeout(function () { window.location.reload(); }, 1200);
					}).catch(function (err) {
						button.disabled = false;
						setStatus("Failed: " + err.message, false);
					});
				});
			})();
		</script>
	}
}

templ ApprovalBadge(status string) {
	if status == "approved" {
		<span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">Approved</span>
	} else if status == "rejected" {
		<span class="rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-700">Rejected</span>
	} else if status == "pending" {
		<span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">Pending review</span>
	} else if status == "deleted" {
		<span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-600">Deleted</span>
	} else {
		<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{ status }</span>
	}
}

templ MessageStatusBadge(status string) {
	if status == "read" {
		<span class="rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">Read</span>
	} else if status == "delivered" {
		<span class="rounded-full bg-sky-100 px-2 py-0.5 text-xs font-medium text-sky-700">Delivered</span>
	} else if status == "sent" {
		<span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">Sent</span>
	} else if status == "queued" {
		<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">Queued</span>
	} else if status == "failed" {
		<span class="rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-700">Failed</span>
	} else {
		<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{ status }</span>
	}
}