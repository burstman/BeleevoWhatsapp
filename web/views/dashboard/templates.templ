package viewsdashboard

import (
	"whatsappconverty/internal/whatsapp"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"

	"github.com/google/uuid"
)

templ TemplatesPage(page components.Page, templates []whatsapp.MerchantTemplate, shopNames map[uuid.UUID]string, flash TemplateFlash) {
	@layouts.Shell(page) {
		<div class="space-y-6">
			<div class="flex items-center justify-between">
				<div>
					<h2 class="text-xl font-semibold text-slate-900">Templates</h2>
					<p class="text-sm text-slate-500">
						Only <span class="font-medium text-emerald-600">approved</span> templates can be
						sent. Approval is decided by Meta's review — not by us.
					</p>
				</div>
				<a href="/templates/refresh"
					class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
					Refresh from Meta
				</a>
			</div>

			if flash.Error != "" {
				<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{ flash.Error }</div>
			}
			if flash.Info != "" {
				<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">{ flash.Info }</div>
			}

			<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
				<div class="flex items-center justify-between">
					<div>
						<h3 class="text-sm font-semibold text-slate-700">Create a template</h3>
						<p class="mt-1 text-xs text-slate-500">
							Submitted to Meta for review. Category is fixed to <span class="font-medium">Utility</span> —
							this platform only sends transactional updates, not marketing.
						</p>
					</div>
					<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">UTILITY</span>
				</div>

				<form id="createTemplateForm" method="post" action="/templates/create" class="mt-4 space-y-3"
					x-data="templateEditor" @submit="onSubmit">
					<div class="grid gap-3 sm:grid-cols-2">
						<div>
							<label for="tplName" class="block text-xs font-medium text-slate-600">Name</label>
							<input id="tplName" name="name" required pattern="[a-z0-9_]{1,60}"
								placeholder="order_shipped" title="lowercase letters, digits, underscores"
								class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
						</div>
						<div>
							<label for="tplLang" class="block text-xs font-medium text-slate-600">Language</label>
							<select id="tplLang" name="language" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
								<option value="ar">Arabic (ar)</option>
								<option value="en">English (en)</option>
								<option value="fr">French (fr)</option>
							</select>
						</div>
					</div>

					<div>
						<label class="block text-xs font-medium text-slate-600">Message</label>
						<p class="mt-1 text-xs text-slate-500">
							Write the message and drag a variable in where the customer's info should appear. No need
							to type &#123;&#123;1&#125;&#125; — the chips handle it.
						</p>

						<div class="mt-2 flex flex-wrap gap-2" aria-label="Variables">
							for _, chip := range whatsapp.VariableChips() {
								<span draggable="true" data-value={ chip.Value } data-label={ chip.Label } data-example={ chip.Example }
									@dragstart="onDragStart($event)"
									@dragend="dragging = ''"
									:class="dragging === $el.dataset.value ? 'opacity-40' : ''"
									class="cursor-grab select-none rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700 transition hover:bg-indigo-100">
									{ chip.Label }
								</span>
							}
						</div>

						<div x-ref="body" contenteditable="true" role="textbox" aria-multiline="true"
							data-placeholder="Your message text — drag chips from above into place."
							@dragenter.prevent="dragOver = true"
							@dragover.prevent="dragOver = true"
							@dragleave="dragOver = false"
							@drop.prevent="onDrop($event)"
							@input="sync"
							@keyup="sync"
							@paste="onPaste($event)"
							:class="'mt-2 min-h-28 overflow-y-auto rounded-lg border px-3 py-2 text-sm shadow-sm focus:outline-none ' + (dragOver ? 'border-indigo-400 ring-2 ring-indigo-100' : 'border-slate-300 focus:border-indigo-500')"></div>
						<input type="hidden" name="body" x-ref="bodyField" />

						<div x-ref="vars" class="mt-3 grid gap-2 sm:grid-cols-2"></div>
						<p class="mt-2 text-xs text-slate-500" x-text="statusText"></p>
					</div>

					<div class="flex items-center gap-3">
						<button type="submit"
							class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
							Submit for review
						</button>
					</div>
				</form>

				<style>
					[contenteditable]:empty::before { content: attr(data-placeholder); color: #94a3b8; pointer-events: none; }
				</style>

				<script>
					document.addEventListener("alpine:init", function () {
						Alpine.data("templateEditor", function () {
							return {
								dragOver: false,
								dragging: "",
								statusText: "",
								lastVars: "",

								init: function () {
									var self = this;
									this.$nextTick(function () { self.sync(); });
								},

								onDragStart: function (evt) {
									var target = evt.currentTarget;
									evt.dataTransfer.effectAllowed = "copy";
									evt.dataTransfer.setData("text/plain", target.getAttribute("data-label"));
									evt.dataTransfer.setData("text/variable", target.getAttribute("data-value"));
									this.dragging = target.getAttribute("data-value");
								},

								onDrop: function (evt) {
									this.dragOver = false;
									var value = evt.dataTransfer.getData("text/variable");
									var label = evt.dataTransfer.getData("text/plain");
									if (!value || !label) { return; }
									var sel = window.getSelection();
									if (!sel || !sel.rangeCount) { return; }
									var range = sel.getRangeAt(0);
									range.deleteContents();
									var pill = this.makePill(value, label);
									range.insertNode(pill);
									this.placeCaretAfter(pill);
									this.sync();
								},

								makePill: function (value, label) {
									var span = document.createElement("span");
									span.setAttribute("data-token", value);
									span.setAttribute("contenteditable", "false");
									span.className = "mx-0.5 whitespace-nowrap rounded bg-indigo-100 px-1.5 py-0.5 font-medium text-indigo-800";
									span.textContent = label;
									return span;
								},

								placeCaretAfter: function (node) {
									var range = document.createRange();
									range.setStartAfter(node);
									range.collapse(true);
									var sel = window.getSelection();
									sel.removeAllRanges();
									sel.addRange(range);
								},

								onPaste: function (evt) {
									evt.preventDefault();
									var text = (evt.clipboardData || window.clipboardData).getData("text/plain");
									if (!text) { return; }
									var sel = window.getSelection();
									if (!sel || !sel.rangeCount) { return; }
									var range = sel.getRangeAt(0);
									range.deleteContents();
									var textNode = document.createTextNode(text);
									range.insertNode(textNode);
									range.setStartAfter(textNode);
									range.collapse(true);
									sel.removeAllRanges();
									sel.addRange(range);
									this.sync();
								},

serializeBody: function (root) {
									var out = "";
									var LB = String.fromCharCode(123, 123);
									var RB = String.fromCharCode(125, 125);
									var walkChildren = function (node) {
										for (var i = 0; i < node.childNodes.length; i++) {
											walk(node.childNodes[i]);
										}
									};
									var walk = function (node) {
										if (node.nodeType === Node.TEXT_NODE) { out += node.nodeValue; return; }
										if (node.nodeType !== Node.ELEMENT_NODE) { return; }
										if (node.hasAttribute("data-token")) {
											out += LB + node.getAttribute("data-token") + RB;
											return;
										}
										if (node.tagName === "BR") { out += "\n"; return; }
										if (node.tagName === "DIV" || node.tagName === "P") {
											walkChildren(node);
											out += "\n";
											return;
										}
										walkChildren(node);
									};
									walk(root);
									return out.replace(/[ \t]+\n/g, "\n").replace(/\n{3,}/g, "\n\n").replace(/^\n+|\n+$/g, "");
								},

								sync: function () {
									this.$refs.bodyField.value = this.serializeBody(this.$refs.body);
									this.renderVars();
								},

								renderVars: function () {
									var seen = [];
									var re = /\{\{([a-zA-Z][a-zA-Z0-9_]*)\}\}/g;
									var m;
									var body = this.serializeBody(this.$refs.body);
									while ((m = re.exec(body)) !== null) {
										if (seen.indexOf(m[1]) === -1) { seen.push(m[1]); }
									}
									this.statusText = seen.length
										? seen.length + " variable(s) — add an example value for each"
										: "";

									var key = seen.join(",");
									if (key === this.lastVars) { return; }
									this.lastVars = key;

									var saved = {};
									var oldInputs = this.$refs.vars.querySelectorAll("input");
									for (var i = 0; i < oldInputs.length; i++) {
										saved[oldInputs[i].name] = oldInputs[i].value;
									}
									this.$refs.vars.innerHTML = "";

									for (var j = 0; j < seen.length; j++) {
										var token = seen[j];
										var chip = document.querySelector('[data-value="' + token + '"]');
										var label = chip ? chip.getAttribute("data-label") : token;
										var example = chip ? chip.getAttribute("data-example") : "";

										var wrap = document.createElement("div");
										var lab = document.createElement("label");
										lab.className = "block text-xs font-medium text-slate-600";
										lab.setAttribute("for", "example_" + token);
										lab.textContent = "Example for " + label;

										var inp = document.createElement("input");
										inp.id = "example_" + token;
										inp.name = "example_" + token;
										inp.type = "text";
										inp.required = true;
										inp.value = saved["example_" + token] || "";
										inp.placeholder = "e.g. " + example;
										inp.className = "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm";

										wrap.appendChild(lab);
										wrap.appendChild(inp);
										this.$refs.vars.appendChild(wrap);
									}
								},

								onSubmit: function () {
									this.sync();
								}
							};
						});
					});
				</script>
			</div>

			<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
				<div class="border-b border-slate-100 px-6 py-4">
					<h3 class="text-sm font-semibold text-slate-700">Your templates</h3>
				</div>
				if len(templates) == 0 {
					<div class="px-6 py-10 text-center text-sm text-slate-500">
						No templates yet. Create one above and its review status will appear here.
					</div>
				} else {
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
							<tr>
								<th class="px-6 py-3 font-medium">Name</th>
								<th class="px-6 py-3 font-medium">Language</th>
								<th class="px-6 py-3 font-medium">Category</th>
								<th class="px-6 py-3 font-medium">Shop</th>
								<th class="px-6 py-3 font-medium">Status</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							for _, t := range templates {
								<tr>
									<td class="px-6 py-3 font-medium text-slate-900">{ t.Name }</td>
									<td class="px-6 py-3 text-slate-600">{ t.Language }</td>
									<td class="px-6 py-3 text-slate-600">{ t.Category }</td>
									<td class="px-6 py-3 text-slate-600">
										if shopNames[t.ShopID] != "" {
											{ shopNames[t.ShopID] }
										} else {
											<span class="text-slate-400">{ t.ShopID.String()[:8] }</span>
										}
									</td>
									<td class="px-6 py-3">
										if t.ApprovalStatus == "deleted" {
											@ApprovalBadge("deleted")
											<p class="mt-1 text-xs text-slate-500">
												Automatically deleted — Meta treated it as marketing content.
											</p>
											if t.MetaWarnings != "" {
												<p class="mt-1 text-xs text-slate-400 italic">{ t.MetaWarnings }</p>
											}
										} else if t.MarketingFlagged {
											<span class="inline-flex items-center gap-1 rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-700">
												Blocked — marketing
											</span>
											<p class="mt-1 text-xs text-rose-600">
												Meta treats this as marketing content; it will never be sent. Delete it and
												rewrite as a transactional update.
											</p>
											if t.MetaWarnings != "" {
												<p class="mt-1 text-xs text-slate-400 italic">{ t.MetaWarnings }</p>
											}
											if t.RejectionReason != "" {
												<p class="mt-1 text-xs text-rose-700">{ t.RejectionReason }</p>
											}
										} else if t.ApprovalStatus == "rejected" {
											@ApprovalBadge("rejected")
											if t.RejectionReason != "" {
												<p class="mt-1 text-xs text-rose-700">{ t.RejectionReason }</p>
											}
										} else {
											@ApprovalBadge(t.ApprovalStatus)
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
</div>
	</div>
}
}

type TemplateFlash struct {
	Error string
	Info  string
}

templ ApprovalBadge(status string) {
	if status == "approved" {
		<span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">Approved</span>
	} else if status == "rejected" {
		<span class="rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-700">Rejected</span>
	} else if status == "pending" {
		<span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">Pending review</span>
	} else if status == "deleted" {
		<span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-600">Deleted</span>
	} else {
		<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{ status }</span>
	}
}