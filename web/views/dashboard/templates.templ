package viewsdashboard

import (
	"whatsappconverty/internal/i18n"
	"whatsappconverty/internal/whatsapp"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"

	"github.com/google/uuid"
)

templ TemplatesPage(page components.Page, templates []whatsapp.MerchantTemplate, shopNames map[uuid.UUID]string, flash TemplateFlash) {
	@layouts.Shell(page) {
		<div class="space-y-6">
			<div class="flex items-center justify-between">
				<div>
					<h2 class="text-xl font-semibold text-slate-900">{ page.T("tpl.title") }</h2>
					<p class="text-sm text-slate-500">
						{ page.T("tpl.subtitleA") }<span class="font-medium text-emerald-600">{ page.T("tpl.approvedWord") }</span>{ page.T("tpl.subtitleB") }
					</p>
				</div>
				<a href="/templates/refresh"
					class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
					{ page.T("tpl.refresh") }
				</a>
			</div>

			if flash.Error != "" {
				<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{ flash.Error }</div>
			}
			if flash.Info != "" {
				<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">{ flash.Info }</div>
			}

			<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
				<div class="flex items-center justify-between">
					<div>
						<h3 class="text-sm font-semibold text-slate-700">{ page.T("tpl.create") }</h3>
						<p class="mt-1 text-xs text-slate-500">
							{ page.T("tpl.createHintA") }<span class="font-medium">{ page.T("tpl.utility") }</span>{ page.T("tpl.createHintB") }
						</p>
					</div>
					<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">UTILITY</span>
				</div>

				<form id="createTemplateForm" method="post" action="/templates/create" class="mt-4 space-y-3"
					x-data="templateEditor" @submit="onSubmit">
					<div>
						<label for="tplSource" class="block text-xs font-medium text-slate-600">{ page.T("tpl.sourceFor") }</label>
						<select id="tplSource" name="source" x-model="source" required
							class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
							for _, opt := range whatsapp.SourceOptions() {
								<option value={ opt.Value }>{ page.T("src." + opt.Value + ".label") } — { page.T("src." + opt.Value + ".hint") }</option>
							}
						</select>
					</div>

					<div class="grid gap-3 sm:grid-cols-2">
						<div>
							<label for="tplName" class="block text-xs font-medium text-slate-600">{ page.T("tpl.name") }</label>
							<input id="tplName" name="name" required pattern="[a-z0-9_]{1,60}"
								placeholder="order_shipped" title={ page.T("tpl.nameTitle") }
								class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
						</div>
						<div>
							<label for="tplLang" class="block text-xs font-medium text-slate-600">{ page.T("tpl.language") }</label>
							<select id="tplLang" name="language" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
								<option value="ar">Arabic (ar)</option>
								<option value="en">English (en)</option>
								<option value="fr">French (fr)</option>
							</select>
						</div>
					</div>

					<div>
						<label class="block text-xs font-medium text-slate-600">{ page.T("tpl.message") }</label>
						<p class="mt-1 text-xs text-slate-500">{ page.T("tpl.messageHint") }</p>

						<div class="mt-2 flex flex-wrap gap-2" aria-label="Variables">
							for _, chip := range whatsapp.VariableChips() {
								<span draggable="true" data-value={ chip.Value } data-label={ page.T("chip." + chip.Value) } data-example={ chip.Example } data-for={ chip.Sources() }
									x-show="chipVisible($el)"
									@dragstart="onDragStart($event)"
									@dragend="dragging = ''"
									:class="dragging === $el.dataset.value ? 'opacity-40' : ''"
									class="cursor-grab select-none rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700 transition hover:bg-indigo-100">
									{ page.T("chip." + chip.Value) }
								</span>
							}
						</div>

						<div x-ref="body" contenteditable="true" role="textbox" aria-multiline="true"
							data-placeholder={ page.T("tpl.bodyPlaceholder") }
							@dragenter.prevent="dragOver = true"
							@dragover.prevent="dragOver = true"
							@dragleave="dragOver = false"
							@drop.prevent="onDrop($event)"
							@input="sync"
							@keyup="sync"
							@paste="onPaste($event)"
							:class="'mt-2 min-h-28 overflow-y-auto rounded-lg border px-3 py-2 text-sm shadow-sm focus:outline-none ' + (dragOver ? 'border-indigo-400 ring-2 ring-indigo-100' : 'border-slate-300 focus:border-indigo-500')"></div>
						<input type="hidden" name="body" x-ref="bodyField" />

						<div class="mt-1 flex items-center justify-between text-xs">
							<span class="text-slate-500">{ page.T("tpl.charLimitA") }<span class="font-medium text-slate-700">{ page.T("tpl.charLimitB") }</span></span>
							<span :class="charCount > charLimit ? 'font-semibold text-rose-600' : 'text-slate-500'"
								x-text="charCount + ' / ' + charLimit"></span>
						</div>
						<p x-show="bodyProblem" x-text="bodyProblem"
							class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800"></p>

						<div x-ref="vars" class="mt-3 grid gap-2 sm:grid-cols-2"></div>
						<p class="mt-2 text-xs text-slate-500" x-text="statusText"></p>
					</div>

					<div class="flex items-center gap-3">
						<button type="submit"
							:disabled="blocked"
							:class="blocked ? 'cursor-not-allowed bg-slate-300' : 'bg-indigo-600 hover:bg-indigo-700'"
							class="inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium text-white transition">
							{ page.T("tpl.submit") }
						</button>
					</div>
				</form>

				<style>
					[contenteditable]:empty::before { content: attr(data-placeholder); color: #94a3b8; pointer-events: none; }
				</style>

				<script>
				window.templateEditorI18N = { !templateEditorMessages(page.I18N) };
				window.templateEditorFmt = function () {
					var args = Array.prototype.slice.call(arguments);
					var s = args.shift();
					return s.replace(/%s/g, function () { return args.shift() || ''; });
				};
				document.addEventListener("alpine:init", function () {
						Alpine.data("templateEditor", function () {
							return {
								dragOver: false,
								dragging: "",
								statusText: "",
								bodyProblem: "",
								lastVars: "",
								charLimit: 1024,
								charCount: 0,
								source: "converty",

								get blocked() {
									return this.charCount > this.charLimit || this.bodyProblem !== "";
								},

								// Mirrors whatsapp.ValidateTemplateBody: Meta refuses a body
								// whose variables open or close the message (subcode 2388299)
								// or that carry too little static text (subcode 2388293).
								checkBody: function (text) {
									var re = /\{\{([a-zA-Z][a-zA-Z0-9_]*)\}\}/g, m, found = [];
									while ((m = re.exec(text)) !== null) { found.push(m); }
									if (!found.length) { return ""; }

									var first = found[0];
									if (text.indexOf(first[0]) === text.search(/\S/)) {
										return window.templateEditorFmt(window.templateEditorI18N.startVar, first[1]);
									}

									var last = found[found.length - 1];
									var tail = text.slice(last.index + last[0].length).replace(/[\s.!?]+$/, "");
									if (tail.trim() === "") {
										return window.templateEditorFmt(window.templateEditorI18N.endVar, last[1]);
									}

									var words = text.replace(/\{\{[^}]*\}\}/g, " ").split(/[^\p{L}\p{N}]+/u).filter(Boolean);
									var need = 3 * found.length;
									if (words.length < need) {
										return window.templateEditorFmt(window.templateEditorI18N.needsWords, need, found.length, words.length, first[1], last[1]);
									}
									return "";
								},

								chipVisible: function (el) {
									return el.dataset.for.split(",").indexOf(this.source) !== -1;
								},

								init: function () {
									var self = this;
									this.$nextTick(function () { self.sync(); });
								},

								onDragStart: function (evt) {
									var target = evt.currentTarget;
									evt.dataTransfer.effectAllowed = "copy";
									evt.dataTransfer.setData("text/plain", target.getAttribute("data-label"));
									evt.dataTransfer.setData("text/variable", target.getAttribute("data-value"));
									this.dragging = target.getAttribute("data-value");
								},

								onDrop: function (evt) {
									this.dragOver = false;
									var value = evt.dataTransfer.getData("text/variable");
									var label = evt.dataTransfer.getData("text/plain");
									if (!value || !label) { return; }
									var sel = window.getSelection();
									if (!sel || !sel.rangeCount) { return; }
									var range = sel.getRangeAt(0);
									range.deleteContents();
									var pill = this.makePill(value, label);
									range.insertNode(pill);
									this.placeCaretAfter(pill);
									this.sync();
								},

								makePill: function (value, label) {
									var span = document.createElement("span");
									span.setAttribute("data-token", value);
									span.setAttribute("contenteditable", "false");
									span.className = "mx-0.5 whitespace-nowrap rounded bg-indigo-100 px-1.5 py-0.5 font-medium text-indigo-800";
									span.textContent = label;
									return span;
								},

								placeCaretAfter: function (node) {
									var range = document.createRange();
									range.setStartAfter(node);
									range.collapse(true);
									var sel = window.getSelection();
									sel.removeAllRanges();
									sel.addRange(range);
								},

								onPaste: function (evt) {
									evt.preventDefault();
									var text = (evt.clipboardData || window.clipboardData).getData("text/plain");
									if (!text) { return; }
									var sel = window.getSelection();
									if (!sel || !sel.rangeCount) { return; }
									var range = sel.getRangeAt(0);
									range.deleteContents();
									var textNode = document.createTextNode(text);
									range.insertNode(textNode);
									range.setStartAfter(textNode);
									range.collapse(true);
									sel.removeAllRanges();
									sel.addRange(range);
									this.sync();
								},

serializeBody: function (root) {
									var out = "";
									var LB = String.fromCharCode(123, 123);
									var RB = String.fromCharCode(125, 125);
									var walkChildren = function (node) {
										for (var i = 0; i < node.childNodes.length; i++) {
											walk(node.childNodes[i]);
										}
									};
									var walk = function (node) {
										if (node.nodeType === Node.TEXT_NODE) { out += node.nodeValue; return; }
										if (node.nodeType !== Node.ELEMENT_NODE) { return; }
										if (node.hasAttribute("data-token")) {
											out += LB + node.getAttribute("data-token") + RB;
											return;
										}
										if (node.tagName === "BR") { out += "\n"; return; }
										if (node.tagName === "DIV" || node.tagName === "P") {
											walkChildren(node);
											out += "\n";
											return;
										}
										walkChildren(node);
									};
									walk(root);
									return out.replace(/[ \t]+\n/g, "\n").replace(/\n{3,}/g, "\n\n").replace(/^\n+|\n+$/g, "");
								},

								sync: function () {
									var text = this.serializeBody(this.$refs.body);
									this.$refs.bodyField.value = text;
									this.charCount = text.length;
									this.bodyProblem = this.checkBody(text);
									this.renderVars();
								},

								renderVars: function () {
									var seen = [];
									var re = /\{\{([a-zA-Z][a-zA-Z0-9_]*)\}\}/g;
									var m;
									var body = this.serializeBody(this.$refs.body);
									while ((m = re.exec(body)) !== null) {
										if (seen.indexOf(m[1]) === -1) { seen.push(m[1]); }
									}
									this.statusText = seen.length
										? window.templateEditorFmt(window.templateEditorI18N.vars, seen.length)
										: "";

									var key = seen.join(",");
									if (key === this.lastVars) { return; }
									this.lastVars = key;

									var saved = {};
									var oldInputs = this.$refs.vars.querySelectorAll("input");
									for (var i = 0; i < oldInputs.length; i++) {
										saved[oldInputs[i].name] = oldInputs[i].value;
									}
									this.$refs.vars.innerHTML = "";

									for (var j = 0; j < seen.length; j++) {
										var token = seen[j];
										var chip = document.querySelector('[data-value="' + token + '"]');
										var label = chip ? chip.getAttribute("data-label") : token;
										var example = chip ? chip.getAttribute("data-example") : "";

										var wrap = document.createElement("div");
										var lab = document.createElement("label");
										lab.className = "block text-xs font-medium text-slate-600";
										lab.setAttribute("for", "example_" + token);
										lab.textContent = window.templateEditorFmt(window.templateEditorI18N.exampleFor, label);

										var inp = document.createElement("input");
										inp.id = "example_" + token;
										inp.name = "example_" + token;
										inp.type = "text";
										inp.required = true;
										inp.value = saved["example_" + token] || "";
										inp.placeholder = window.templateEditorFmt(window.templateEditorI18N.example, example);
										inp.className = "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm";

										wrap.appendChild(lab);
										wrap.appendChild(inp);
										this.$refs.vars.appendChild(wrap);
									}
								},

								onSubmit: function () {
									this.sync();
								}
							};
						});
					});
				</script>
			</div>

			<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
				<div class="border-b border-slate-100 px-6 py-4">
					<h3 class="text-sm font-semibold text-slate-700">{ page.T("tpl.yourTemplates") }</h3>
				</div>
				if len(templates) == 0 {
					<div class="px-6 py-10 text-center text-sm text-slate-500">
						{ page.T("tpl.empty") }
					</div>
				} else {
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
							<tr>
								<th class="px-6 py-3 font-medium">{ page.T("tpl.colName") }</th>
								<th class="px-6 py-3 font-medium">{ page.T("tpl.colLanguage") }</th>
								<th class="px-6 py-3 font-medium">{ page.T("tpl.colCategory") }</th>
								<th class="px-6 py-3 font-medium">{ page.T("tpl.colFor") }</th>
								<th class="px-6 py-3 font-medium">{ page.T("tpl.colShop") }</th>
								<th class="px-6 py-3 font-medium">{ page.T("tpl.colStatus") }</th>
								<th class="px-6 py-3 text-right font-medium">{ page.T("tpl.colActions") }</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							for _, t := range templates {
								<tr>
									<td class="px-6 py-3 font-medium text-slate-900">{ t.Name }</td>
									<td class="px-6 py-3 text-slate-600">{ t.Language }</td>
									<td class="px-6 py-3 text-slate-600">{ t.Category }</td>
									<td class="px-6 py-3 text-slate-600">{ page.T(sourceLabelKey(t.Source)) }</td>
									<td class="px-6 py-3 text-slate-600">
										if shopNames[t.ShopID] != "" {
											{ shopNames[t.ShopID] }
										} else {
											<span class="text-slate-400">{ t.ShopID.String()[:8] }</span>
										}
									</td>
									<td class="px-6 py-3">
										if t.ApprovalStatus == "deleted" {
											@ApprovalBadge(page.I18N, "deleted")
											<p class="mt-1 text-xs text-slate-500">
												{ page.T("tpl.deletedNote") }
											</p>
											if t.MetaWarnings != "" {
												<p class="mt-1 text-xs text-slate-400 italic">{ t.MetaWarnings }</p>
											}
										} else if t.MarketingFlagged {
											<span class="inline-flex items-center gap-1 rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-700">
												{ page.T("tpl.blockedMarketing") }
											</span>
											<p class="mt-1 text-xs text-rose-600">
												{ page.T("tpl.marketingNote") }
											</p>
											if t.MetaWarnings != "" {
												<p class="mt-1 text-xs text-slate-400 italic">{ t.MetaWarnings }</p>
											}
											if t.RejectionReason != "" {
												<p class="mt-1 text-xs text-rose-700">{ t.RejectionReason }</p>
											}
										} else if t.ApprovalStatus == "rejected" {
											@ApprovalBadge(page.I18N, "rejected")
											if t.RejectionReason != "" {
												<p class="mt-1 text-xs text-rose-700">{ t.RejectionReason }</p>
											}
										} else {
											@ApprovalBadge(page.I18N, t.ApprovalStatus)
										}
									</td>
									<td class="px-6 py-3 text-right">
										if t.ApprovalStatus == "deleted" {
											<span class="text-xs text-slate-400">—</span>
										} else {
											<form method="post" action={ templ.URL("/templates/" + t.ID.String() + "/delete") }
												data-confirm={ page.Tf("tpl.deleteConfirm", t.Name, t.Language) }>
												<button type="submit"
													class="rounded-lg border border-rose-200 bg-white px-3 py-1.5 text-xs font-medium text-rose-600 transition hover:bg-rose-50">
													{ page.T("tpl.delete") }
												</button>
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
</div>
	</div>
}
}

type TemplateFlash struct {
	Error string
	Info  string
}

// sourceLabelKey maps a stored template source to the dict key for its short
// form as shown in the templates table, mirroring whatsapp.SourceLabel.
func sourceLabelKey(source string) string {
	switch source {
	case whatsapp.SourceConverty:
		return "src.converty.short"
	case whatsapp.SourceDelivery:
		return "src.delivery.short"
	default:
		return "src.any.short"
	}
}

templ ApprovalBadge(dict *i18n.Dict, status string) {
	if status == "approved" {
		<span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">{ dict.T("tpl.approved") }</span>
	} else if status == "rejected" {
		<span class="rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-700">{ dict.T("tpl.rejected") }</span>
	} else if status == "pending" {
		<span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">{ dict.T("tpl.pending") }</span>
	} else if status == "deleted" {
		<span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-600">{ dict.T("tpl.deleted") }</span>
	} else {
		<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{ status }</span>
	}
}