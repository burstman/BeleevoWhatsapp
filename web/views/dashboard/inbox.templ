package viewsdashboard

import (
	"fmt"
	"strings"
	"time"

	"github.com/google/uuid"

	"whatsappconverty/internal/whatsapp"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

// chatClock renders the wall-clock time for a bubble.
func chatClock(t time.Time) string {
	return t.Local().Format("15:04")
}

// phoneDisplay formats a stored phone (digits only) for display.
func phoneDisplay(phone string) string {
	if phone == "" {
		return "…"
	}
	return "+" + phone
}

func chatStatusLabel(s string) string {
	switch s {
	case "queued", "sent", "delivered", "read", "failed":
		return s
	}
	return ""
}

// conversationName prefers the profile name WhatsApp attached to the customer,
// falling back to the display number.
func conversationName(c whatsapp.Conversation) string {
	if c.CustomerName != "" {
		return c.CustomerName
	}
	return phoneDisplay(c.CustomerPhone)
}

func unreadLabel(n int) string {
	if n > 9 {
		return "9+"
	}
	return fmt.Sprintf("%d", n)
}

// totalUnread sums the unread count across every conversation, for the nav
// badge and the inbox sidebar.
func totalUnread(threads []whatsapp.Conversation) int {
	n := 0
	for _, t := range threads {
		n += t.UnreadCount
	}
	return n
}

// ActiveInboxThread bundles the open conversation for the two-pane inbox.
type ActiveInboxThread struct {
	Conv whatsapp.Conversation
	Msgs []whatsapp.ChatMessage
	Err  string
	Ok   string
}

func activeID(active *ActiveInboxThread) uuid.UUID {
	if active == nil {
		return uuid.Nil
	}
	return active.Conv.ID
}

// InboxPage is the operator's two-pane inbox: the conversation list on the
// left, the open thread (or a selector hint) on the right. The layout and the
// mobile sidebar/detail toggle mirror the shop-admin chat screen.
templ InboxPage(page components.Page, threads []whatsapp.Conversation, shopNames map[uuid.UUID]string, active *ActiveInboxThread, flash string) {
	@layouts.Shell(page) {
		<div class="space-y-6">
			<div>
				<h2 class="text-2xl font-bold text-slate-900">Inbox</h2>
				<p class="mt-1 text-sm text-slate-500">
					Messages customers send to your WhatsApp number. Replies are free-form
					inside the 24h customer service window; after that, only approved templates can reach them.
				</p>
			</div>

			if !page.WhatsAppConnected {
				<div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-8 text-center text-sm text-amber-800">
					<div class="font-semibold">No WhatsApp number connected yet.</div>
					<div class="mt-1">The Inbox unlocks once you connect the number your customers message.</div>
					<a href="/settings" class="mt-4 inline-flex items-center rounded-lg bg-amber-600 px-4 py-2 text-xs font-semibold text-white transition hover:bg-amber-700">Connect your WhatsApp number</a>
				</div>
			} else if len(threads) == 0 {
				<div class="rounded-xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
					<div class="text-sm font-semibold text-slate-700">No conversations yet</div>
					<div class="mt-1 text-sm text-slate-500">
						When a customer messages your WhatsApp number, the conversation appears here.
					</div>
				</div>
			} else {
				if flash != "" {
					<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">{ flash }</div>
				}
				<div class="flex h-[62vh] min-h-[28rem] flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm lg:h-[calc(100vh-10.5rem)] lg:flex-row" x-data="{ showDetail: false }">
					<div :class="showDetail ? 'hidden lg:flex' : 'flex'" class="min-h-0 flex-col border-b border-slate-200 lg:w-[22rem] lg:shrink-0 lg:border-b-0 lg:border-r">
						<div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-3">
							<h3 class="text-sm font-bold text-slate-700">Conversations</h3>
							<span class="rounded-full bg-slate-200 px-2 py-0.5 text-[10px] font-semibold text-slate-600">{ len(threads) }</span>
						</div>
						@ChatSidebar(threads, activeID(active), shopNames, false)
					</div>

					<div id="inbox-thread-pane" :class="showDetail ? 'flex' : 'hidden lg:flex'" class="min-h-0 flex-1 flex-col bg-slate-50">
						if active != nil {
							@ThreadCard(page, active.Conv, active.Msgs, active.Err, active.Ok)
						} else {
							<div class="flex flex-1 flex-col items-center justify-center px-6 py-16 text-center">
								<div class="text-sm font-semibold text-slate-700">Select a conversation</div>
								<div class="mt-1 text-sm text-slate-500">Choose a customer on the left to read and reply to their messages.</div>
							</div>
						}
					</div>
				</div>
			}
		</div>
	}
}

// ChatSidebar is the conversation list. It carries its own polling trigger so
// a full-page render and each swap keep refreshing without a wrapper target.
// When oob is true the whole sidebar is emitted as an out-of-band swap, which
// is how a thread open keeps the list ordered and badges fresh in one request.
templ ChatSidebar(threads []whatsapp.Conversation, activeID uuid.UUID, shopNames map[uuid.UUID]string, oob bool) {
	if oob {
		<div id="inbox-sidebar" hx-get="/inbox/sidebar" hx-trigger="every 20s" hx-swap="outerHTML" hx-swap-oob="outerHTML" class="min-h-0 flex-1 divide-y divide-slate-100 overflow-y-auto">
			@chatSidebarRows(threads, activeID, shopNames)
		</div>
	} else {
		<div id="inbox-sidebar" hx-get="/inbox/sidebar" hx-trigger="every 20s" hx-swap="outerHTML" class="min-h-0 flex-1 divide-y divide-slate-100 overflow-y-auto">
			@chatSidebarRows(threads, activeID, shopNames)
		</div>
	}
}

// InboxSidebar is the polling response: the sidebar plus the nav badge update.
templ InboxSidebar(threads []whatsapp.Conversation, activeID uuid.UUID, shopNames map[uuid.UUID]string) {
	@ChatSidebar(threads, activeID, shopNames, false)
	@NavBadgeOOB(totalUnread(threads))
}

// InboxThreadSwap is the htmx response for opening a thread: the thread card
// plus out-of-band updates to the sidebar and the nav badge.
templ InboxThreadSwap(page components.Page, conv whatsapp.Conversation, msgs []whatsapp.ChatMessage, err string, ok string, threads []whatsapp.Conversation, activeID uuid.UUID, shopNames map[uuid.UUID]string) {
	@ThreadCard(page, conv, msgs, err, ok)
	@ChatSidebar(threads, activeID, shopNames, true)
	@NavBadgeOOB(totalUnread(threads))
}

// NavBadgeOOB rewrites the Inbox item's unread badge after an inbox request.
templ NavBadgeOOB(count int) {
	if count > 0 {
		<span id="inbox-nav-badge" hx-swap-oob="outerHTML" class="ml-auto inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-indigo-500 px-1.5 text-[10px] font-bold text-white">{ unreadLabel(count) }</span>
	} else {
		<span id="inbox-nav-badge" hx-swap-oob="outerHTML" class="hidden"></span>
	}
}

templ chatSidebarRows(threads []whatsapp.Conversation, activeID uuid.UUID, shopNames map[uuid.UUID]string) {
	if len(threads) == 0 {
		<p class="px-4 py-6 text-center text-sm text-slate-500">No conversations yet.</p>
	} else {
		for _, t := range threads {
			<a href={ templ.SafeURL("/inbox/" + t.ID.String()) } hx-get={ templ.SafeURL("/inbox/" + t.ID.String()) } hx-target="#inbox-thread-pane" hx-swap="innerHTML" hx-push-url="true" class={ "flex w-full items-center gap-3 px-3 py-3 text-left transition hover:bg-slate-50 focus:outline-none sm:px-4", templ.KV("bg-indigo-50/70", t.ID == activeID) }>
				<div class={ "flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-xs font-bold", templ.KV("bg-indigo-100 text-indigo-700", t.UnreadCount == 0), templ.KV("bg-indigo-600 text-white", t.UnreadCount > 0) }>{ avatarLetters(conversationName(t)) }</div>
				<div class="min-w-0 flex-1">
					<div class="flex items-center justify-between gap-2">
						<span class="truncate text-sm font-semibold text-slate-900">{ conversationName(t) }</span>
						<span class="shrink-0 text-[10px] text-slate-400">{ chatClock(t.LastMessageAt) }</span>
					</div>
					<div class="mt-0.5 flex items-center justify-between gap-2">
						<span class={ "truncate text-[13px] ", templ.KV("font-medium text-slate-800", t.UnreadCount > 0), templ.KV("text-slate-500", t.UnreadCount == 0) }>{ t.LastBody }</span>
						if t.UnreadCount > 0 {
							<span class="shrink-0 rounded-full bg-indigo-600 px-1.5 py-0.5 text-[10px] font-bold text-white">{ unreadLabel(t.UnreadCount) }</span>
						}
					</div>
				</div>
			</a>
		}
	}
}

// avatarLetters derives a short initial badge for the messenger-style list.
func avatarLetters(name string) string {
	fields := strings.Fields(name)
	var b strings.Builder
	for _, f := range fields {
		if f != "" {
			b.WriteRune(rune(f[0]))
		}
		if b.Len() >= 2 {
			break
		}
	}
	out := strings.ToUpper(b.String())
	if out == "" {
		return "#"
	}
	return out
}

// whatsappBadge is the familiar green WhatsApp glyph used on conversation rows
// and the thread header, exactly like the shop chat.
templ whatsappBadge(size string) {
	<span class={ "inline-flex shrink-0 items-center justify-center rounded-full bg-[#25D366] text-white", size }>
		<svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
	</span>
}

// ThreadCard is the whole open conversation: header, message bubbles (which
// poll for new inbound on their own) and the reply box. The card is the htmx
// swap target after a reply, so the outgoing bubble and the cleared textarea
// land in one exchange. x-init flips the mobile sidebar/detail toggle so
// opening a thread shows the detail area on small screens.
templ ThreadCard(page components.Page, conv whatsapp.Conversation, msgs []whatsapp.ChatMessage, err string, ok string) {
	<div id="thread-card" class="flex min-h-0 flex-1 flex-col overflow-hidden" x-init="showDetail = true">
		<div class="flex items-center justify-between gap-3 border-b border-slate-200 bg-white px-3 py-3 shadow-sm sm:px-4">
			<div class="flex min-w-0 items-center gap-2">
				<button type="button" class="-ml-1 rounded-md p-1 text-slate-500 hover:text-slate-700 lg:hidden" @click="showDetail = false" aria-label="Back to conversations">
					<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
				</button>
				<span class="inline-flex shrink-0 items-center gap-1.5">
					@whatsappBadge("h-5 w-5")
					<span class="truncate text-sm font-bold text-slate-900">{ conversationName(conv) }</span>
					<span class="shrink-0 text-xs font-normal text-slate-400">({ phoneDisplay(conv.CustomerPhone) })</span>
				</span>
			</div>
			if conv.WindowOpen {
				<span class="shrink-0 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">Service window open</span>
			} else {
				<span class="shrink-0 rounded-full bg-rose-50 px-2.5 py-1 text-xs font-medium text-rose-700">Window closed</span>
			}
		</div>

		<div id="thread-bubbles" class="min-h-0 flex-1 space-y-2 overflow-y-auto bg-slate-50 p-2 scroll-smooth sm:space-y-4 sm:p-6"
			style="overflow-anchor: none;"
			hx-get={ templ.SafeURL("/inbox/" + conv.ID.String() + "/fragment") }
			hx-trigger="every 15s" hx-swap="innerHTML"
			x-init="$nextTick(() => $el.scrollTop = $el.scrollHeight)"
			hx-on::after-swap="const el=this; if (el.scrollTop + el.clientHeight >= el.scrollHeight - 260) { el.scrollTop = el.scrollHeight; }">
			@BubblesList(msgs)
		</div>

		<div id="thread-typing" class="h-5 border-t border-slate-100 bg-slate-50 px-4 text-[10px] italic text-slate-400"></div>

		if err != "" {
			<div class="border-t border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{ err }</div>
		}
		if ok != "" {
			<div class="border-t border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">{ ok }</div>
		}

		if conv.WindowOpen {
			<div class="border-t border-slate-200 bg-white p-2 sm:p-4">
				<p class="px-1 pb-1 text-[10px] text-amber-600">Reply goes via WhatsApp. Free-form replies only work within 24h of the customer's last message.</p>
				<form class="flex items-center gap-2"
					hx-post={ templ.SafeURL("/inbox/" + conv.ID.String() + "/reply") }
					hx-target="#thread-card" hx-swap="outerHTML" hx-disabled-elt="find button">
					<input type="text" name="body" required maxlength="2000" autocomplete="off" placeholder="Reply…"
						class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none" />
					<button type="submit" class="shrink-0 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">Send</button>
				</form>
			</div>
		} else {
			<div class="flex items-center gap-2 border-t border-slate-200 bg-white p-3 sm:p-4">
				<span class="text-sm text-slate-500">Free-form replies are unavailable outside the 24h window.</span>
				<a href="/templates" class="shrink-0 text-sm font-medium text-indigo-600 hover:underline">Use an approved template</a>
			</div>
		}
	</div>
}

// BubblesList is the message area of a thread. It is rendered standalone so the
// thread fragment can re-render just the bubbles on the poll.
templ BubblesList(msgs []whatsapp.ChatMessage) {
	if len(msgs) == 0 {
		<div class="py-2 text-center text-sm text-slate-400">No messages yet</div>
	} else {
		for _, m := range msgs {
			if m.Direction == "inbound" {
				<div class="flex">
					<div class="max-w-[70%] rounded-2xl rounded-bl-sm bg-white px-3 py-2 text-sm text-slate-800 shadow-sm">
						<p class="whitespace-pre-wrap break-words">{ m.Body }</p>
						<div class="mt-0.5 text-right text-[10px] text-slate-400">{ chatClock(m.CreatedAt) }</div>
					</div>
				</div>
			} else {
				<div class="flex justify-end">
					<div class="max-w-[70%] rounded-2xl rounded-br-sm bg-indigo-600 px-3 py-2 text-sm text-white shadow-sm">
						<p class="whitespace-pre-wrap break-words">{ m.Body }</p>
						<div class="mt-0.5 text-right text-[10px] text-indigo-200">{ chatClock(m.CreatedAt) } { chatStatusLabel(m.Status) }</div>
					</div>
				</div>
			}
		}
	}
}