package viewsdashboard

import (
	"github.com/google/uuid"

	"whatsappconverty/internal/shops"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"
)

type ShopFlash struct {
	Info  string
	Error string
}

templ ShopStatusBadge(active bool) {
	if active {
		<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700">
			<span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Active
		</span>
	}
}

templ ShopsPage(page components.Page, shops []shops.Shop, activeID uuid.UUID, flash ShopFlash) {
	@layouts.Shell(page) {
		if flash.Error != "" {
			<div class="mb-4 rounded-lg bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700">{ flash.Error }</div>
		} else if flash.Info != "" {
			<div class="mb-4 rounded-lg bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700">{ flash.Info }</div>
		}

		<div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
			<div>
				<h2 class="text-xl font-semibold text-slate-900">Shops</h2>
				<p class="text-sm text-slate-500">Add the shops you operate, then switch between them from the top-right menu.</p>
			</div>
			<form method="POST" action="/shops" class="flex flex-col gap-2 sm:flex-row sm:items-center">
				<label for="new-shop-name" class="sr-only">Shop name</label>
				<input id="new-shop-name" name="name" type="text" required placeholder="New shop name"
					class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:w-64"/>
				<button type="submit"
					class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-indigo-700">
					Add shop
				</button>
			</form>
		</div>

		if len(shops) == 0 {
			@components.EmptyState("No shops yet", "Create your first shop above to start connecting Converty stores and messaging customers.")
		} else {
			<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
				<ul class="divide-y divide-slate-100">
					for _, s := range shops {
						<li class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
							<div class="min-w-0">
								<div class="flex flex-wrap items-center gap-2">
									<span class="truncate text-base font-semibold text-slate-900">{ s.Name }</span>
									@ShopStatusBadge(s.ID == activeID)
								</div>
								<p class="mt-0.5 text-sm text-slate-500">
									if s.WhatsappEnabled {
										WhatsApp messaging enabled
									} else {
										WhatsApp not enabled
									}
									· created { s.CreatedAt.Format("Jan 2, 2006") }
								</p>
							</div>
							<div class="flex items-center gap-2">
								<form method="POST" action={ templ.SafeURL("/shops/" + s.ID.String() + "/update") } class="flex items-center gap-2">
									<input name="name" value={ s.Name } type="text" required
										class="w-40 rounded-lg border border-slate-300 px-2.5 py-1.5 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500"/>
									<button type="submit"
										class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:border-indigo-300 hover:text-indigo-700">
										Rename
									</button>
								</form>
								if s.ID != activeID {
									<a href={ templ.SafeURL("/shops/" + s.ID.String() + "/select") }
										class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-slate-700">
										Open
									</a>
								}
							</div>
						</li>
					}
				</ul>
			</div>
		}
	}
}