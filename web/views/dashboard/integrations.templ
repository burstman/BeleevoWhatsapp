package viewsdashboard

import (
	"whatsappconverty/internal/converty"
	"whatsappconverty/internal/i18n"
	"whatsappconverty/web/views/components"
	"whatsappconverty/web/views/layouts"

	"github.com/google/uuid"
)

type IntegrationFlash struct {
	Info  string
	Error string
}

templ IntegrationStatusBadge(dict *i18n.Dict, active bool, status string) {
	if !active {
		<span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-500">
			<span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span> { dict.T("int.inactive") }
		</span>
	} else if status == "error" {
		<span class="inline-flex items-center gap-1.5 rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-medium text-rose-700">
			<span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span> { dict.T("int.error") }
		</span>
	} else {
		<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700">
			<span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> { dict.T("int.active") }
		</span>
	}
}

func integrationActionClass(primary bool) string {
	if primary {
		return "bg-indigo-600 text-white hover:bg-indigo-700"
	}
	return "border border-slate-300 text-slate-600 hover:border-indigo-300 hover:text-indigo-700"
}

templ integrationActionButton(dict *i18n.Dict, labelKey string, primary bool) {
	<button type="submit"
		class={ "inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm font-medium transition ", integrationActionClass(primary) }>
		{ dict.T(labelKey) }
	</button>
}

templ IntegrationCard(page components.Page, integration converty.Integration, shopNames map[uuid.UUID]string) {
	<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="flex flex-wrap items-center gap-2">
					<span class="inline-flex items-center gap-1 rounded-md bg-slate-900 px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-white">
						Converty
					</span>
					<h3 class="truncate text-base font-semibold text-slate-900">
						if integration.StoreName != "" {
							{ integration.StoreName }
						} else {
							{ page.T("int.unnamed") }
						}
					</h3>
					@IntegrationStatusBadge(page.I18N, integration.Active, integration.Status)
				</div>
				<p class="mt-1 text-sm text-slate-500">
					if shopNames[integration.ShopID] != "" {
						<span class="font-medium text-slate-700">{ shopNames[integration.ShopID] }</span>
						if integration.StoreDomain != "" || integration.StoreSlug != "" || integration.ConvertyStoreID != "" {
						}
						<span> · </span>
					}
					if integration.StoreDomain != "" {
						{ integration.StoreDomain }
					} else if integration.StoreSlug != "" {
						{ integration.StoreSlug }
					} else if integration.ConvertyStoreID != "" {
						{ page.T("int.storeId") } { integration.ConvertyStoreID }
					} else {
						{ page.T("int.connectedStore") }
					}
				</p>
			</div>
		</div>

		<div class="mt-4 flex flex-wrap items-center gap-2">
			<form method="post" action={ "/integrations/" + integration.ID.String() + "/activate" }>
				if integration.Active {
					<input type="hidden" name="active" value="0" />
					@integrationActionButton(page.I18N, "int.deactivate", false)
				} else {
					<input type="hidden" name="active" value="1" />
					@integrationActionButton(page.I18N, "int.activate", true)
				}
			</form>
			<form method="post" action={ "/integrations/" + integration.ID.String() + "/refresh" }>
				@integrationActionButton(page.I18N, "int.refresh", false)
			</form>
			<form method="post" action={ "/integrations/" + integration.ID.String() + "/test" }>
				@integrationActionButton(page.I18N, "int.test", false)
			</form>

			<details class="group">
				<summary
					class="inline-flex cursor-pointer list-none items-center gap-2 rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:border-indigo-300 hover:text-indigo-700">
					{ page.T("int.modify") }
				</summary>
				<form method="post" action={ "/integrations/" + integration.ID.String() + "/update" }
					class="mt-2 w-full rounded-lg border border-slate-200 bg-slate-50 p-3">
					<div class="grid gap-2 sm:grid-cols-2">
						<div>
							<label class="block text-xs font-medium text-slate-600">{ page.T("int.storeName") }</label>
							<input name="store_name" required
								value={ integration.StoreName }
								class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
						</div>
						<div>
							<label class="block text-xs font-medium text-slate-600">{ page.T("int.storeDomain") }</label>
							<input name="store_domain"
								value={ integration.StoreDomain } placeholder="your-store.converty.shop"
								class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
						</div>
					</div>
					<div class="mt-3 flex items-center gap-2">
						<button type="submit"
							class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-slate-800">
							{ page.T("int.saveDetails") }
						</button>
						<span class="text-xs text-slate-500">{ page.T("int.saveHint") }</span>
					</div>
				</form>
			</details>

			<form method="post" action={ "/integrations/" + integration.ID.String() + "/delete" }
				data-confirm={ page.T("int.deleteConfirm") }>
				<button type="submit"
					class="inline-flex items-center gap-2 rounded-lg border border-rose-200 px-3 py-1.5 text-sm font-medium text-rose-600 transition hover:border-rose-300 hover:bg-rose-50">
					{ page.T("int.delete") }
				</button>
			</form>
		</div>
	</div>
}

templ integretyClientCredentialsForm(dict *i18n.Dict) {
	<details class="group">
		<summary
			class="inline-flex cursor-pointer list-none items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
			{ dict.T("int.connectStore") }
		</summary>
		<form method="post" action="/auth/converty/connect"
			class="mt-3 w-full max-w-xl rounded-lg border border-slate-200 bg-slate-50 p-4">
			<p class="text-sm text-slate-600">
				{ dict.T("int.connectBodyA") }<b>Client ID</b>{ dict.T("int.connectBodyAnd") }<b>Client Secret</b>{ dict.T("int.connectBodyB") }
			</p>
			<div class="mt-3 grid gap-3 sm:grid-cols-2">
				<div>
					<label class="block text-xs font-medium text-slate-600">Client ID</label>
					<input name="converty_client_id" required autocomplete="off" spellcheck="false"
						class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-600">Client Secret</label>
					<input name="converty_client_secret" type="password" required autocomplete="off"
						class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
				</div>
			</div>
			<div class="mt-3 flex items-center gap-3">
				<button type="submit"
					class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">
					{ dict.T("int.authorize") }
				</button>
				<span class="text-xs text-slate-500">{ dict.T("int.credsHint") }</span>
			</div>
		</form>
	</details>
}

templ IntegrationsPage(page components.Page, integrations []converty.Integration, shopNames map[uuid.UUID]string, flash IntegrationFlash) {
	@layouts.Shell(page) {
		<div class="space-y-6">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<h2 class="text-xl font-semibold text-slate-900">{ page.T("int.title") }</h2>
					<p class="text-sm text-slate-500">{ page.T("int.subtitle") }</p>
				</div>
				@integretyClientCredentialsForm(page.I18N)
			</div>

			if flash.Error != "" {
				<div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{ flash.Error }</div>
			}
			if flash.Info != "" {
				<div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">{ flash.Info }</div>
			}

			if len(integrations) == 0 {
				<div class="rounded-xl border border-slate-200 bg-white shadow-sm">
					@components.EmptyState(page.T("int.emptyTitle"), page.T("int.emptyBody"))
				</div>
			} else {
				<div class="space-y-4">
					for _, integration := range integrations {
						@IntegrationCard(page, integration, shopNames)
					}
				</div>
			}
		</div>
	}
}