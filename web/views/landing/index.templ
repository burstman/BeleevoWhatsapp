package viewslanding

import (
	"whatsappconverty/internal/i18n"
	"whatsappconverty/web/views/layouts"
)

templ Index(dict *i18n.Dict) {
	@layouts.AuthLayout(dict.T("landing.brandTitle"), dict) {
		<div class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm text-center">
			<h2 class="text-lg font-semibold text-slate-900">{ dict.T("landing.heading") }</h2>
			<p class="mt-2 text-sm text-slate-500">
				{ dict.T("landing.body") }
			</p>
			<div class="mt-6 flex items-center justify-center gap-3">
				<a href="/login" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500">
					{ dict.T("auth.signIn") }
				</a>
			</div>
			<p class="mt-4 text-sm text-slate-500">
				{ dict.T("landing.provisioned") }
			</p>
			<div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-xs text-slate-500">
				<a href="/privacy" class="font-medium text-slate-600 underline hover:text-slate-700">{ dict.T("legal.privacy") }</a>
				<a href="/data-deletion" class="font-medium text-slate-600 underline hover:text-slate-700">{ dict.T("legal.deletionLong") }</a>
			</div>
		</div>
	}
}