package components

import "whatsappconverty/internal/i18n"

// LanguageSwitcher is the EN/FR/AR picker. It posts the chosen code to
// /language, which persists it on the account and bounces back. Rendered in
// both the dashboard topbar and the public auth layout.
templ LanguageSwitcher(dict *i18n.Dict) {
	<div class="relative" x-data="{ langOpen: false }">
		<button type="button" @click="langOpen = !langOpen"
			class="flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm text-slate-600 transition hover:bg-slate-100"
			aria-haspopup="true" :aria-expanded="langOpen" aria-label={ dict.T("switcher.label") }>
			<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"/></svg>
			<span>{ dict.Lang().Label() }</span>
			<svg class="h-3.5 w-3.5 opacity-60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
		</button>
		<div x-show="langOpen" x-cloak x-transition.opacity @click.outside="langOpen = false"
			class="absolute end-0 top-full z-50 mt-2 w-44 overflow-hidden rounded-lg border border-slate-200 bg-white py-1 shadow-lg">
			for _, l := range i18n.Supported {
				if l == dict.Lang() {
					<button type="button" disabled
						class="flex w-full items-center justify-between px-3 py-2 text-start text-sm font-medium text-indigo-600">
						<span>{ l.Label() }</span>
						<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
					</button>
				} else {
					<form method="POST" action="/language">
						<input type="hidden" name="lang" value={ l.String() }/>
						<button type="submit"
							class="flex w-full items-center px-3 py-2 text-start text-sm text-slate-600 transition hover:bg-slate-50">
							{ l.Label() }
						</button>
					</form>
				}
			}
		</div>
	</div>
}