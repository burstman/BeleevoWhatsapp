# Runtime environment (copy to .env and adjust).
# Never commit real secrets.

APP_ENV=development
APP_NAME=Converty WhatsApp
HTTP_LISTEN_ADDR=:3000
APP_URL=http://localhost:3000

# Render provides this; local dev uses the default below.
# PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/converty_whatsapp?sslmode=disable

# Session signing secret. Must be >= 32 bytes. Same value across web + worker.
SUPERKIT_SECRET=change-me-to-a-long-random-secret-string

# Single operator account. There is no public registration — this one admin
# manages all shops. Seeded automatically on first start.
ADMIN_EMAIL=admin@bleevoo.local
ADMIN_PASSWORD=change-me-admin-12345

# Published on /privacy and /data-deletion as the contact address. Meta's app
# review rejects a privacy policy with no reachable contact, so this must be a
# real, monitored mailbox. The value below is also the built-in default in
# internal/config, so the pages work without setting the variable; override it
# here to publish a different address.
SUPPORT_EMAIL=hamedflissi@gmail.com

# Converty OAuth (Phase 2). Merchant's Converty app credentials are entered
# per integration in the app (stored encrypted); the base/API/redirect URIs
# below still apply platform-wide.
CONVERTY_BASE_URL=https://partner.converty.shop
# Base URL of the Converty REST API (differs from the OAuth host).
CONVERTY_API_URL=https://api.converty.shop
# Must exactly match a redirect URI registered with every merchant's Converty app.
CONVERTY_REDIRECT_URI=http://localhost:3000/auth/converty/callback

# Key used to encrypt Converty tokens at rest (openssl rand -hex 32).
# When unset, development falls back to a SHA-256 of SUPERKIT_SECRET.
CONVERTY_ENCRYPTION_KEY=